<UserControl x:Class="Roshiq.App.Views.HeroesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:Roshiq.App"
             xmlns:ov="clr-namespace:Roshiq.Overlay;assembly=Roshiq.Overlay">
    <Grid Margin="0,0,0,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Каталог героев -->
        <DockPanel Margin="0,0,20,0">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <Grid>
                    <TextBox x:Name="SearchBox" TextChanged="Filter_Changed" Padding="34,8,10,8" ToolTip="{app:T heroes_search}" />
                    <ov:Icon Glyph="{StaticResource I.Search}" Size="15" Brush="{DynamicResource Muted}" HorizontalAlignment="Left" Margin="11,0,0,0" />
                </Grid>
                <UniformGrid Columns="2">
                    <ComboBox x:Name="PositionFilter" Margin="0,3,4,3" MinWidth="0" SelectionChanged="Filter_Changed" />
                    <ComboBox x:Name="AttributeFilter" Margin="4,3,0,3" MinWidth="0" SelectionChanged="Filter_Changed" />
                </UniformGrid>
                <CheckBox x:Name="FavoritesOnly" Content="{app:T my_favorites_only}" Checked="Filter_Changed" Unchecked="Filter_Changed" Margin="2,8,0,0" />
                <TextBlock x:Name="EmptyFavorites" Text="{app:T my_empty_favorites}" Style="{StaticResource MutedText}" Visibility="Collapsed" Margin="2,8,0,0" />
                <TextBlock x:Name="CountText" Style="{StaticResource Eyebrow}" Margin="2,8,0,0" />
            </StackPanel>
            <ListBox x:Name="HeroList" SelectionChanged="HeroList_SelectionChanged" />
        </DockPanel>

        <!-- Карточка героя и сборка -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Details" Margin="0,0,6,0">
                <Border Style="{StaticResource Card}" Padding="26,22">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- портрет героя -->
                        <ContentControl x:Name="PortraitHost" Focusable="False" VerticalAlignment="Top" Margin="0,2,22,0" />
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="HeroMeta" Style="{StaticResource Eyebrow}" />
                            <TextBlock x:Name="HeroName" Style="{StaticResource Display}" FontSize="36" />
                            <WrapPanel x:Name="TraitPanel" Margin="0,14,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Top" Margin="20,0,0,0">
                            <Button x:Name="FavoriteButton" Click="Favorite_Click" HorizontalAlignment="Stretch" Margin="0,0,0,8" />
                            <ComboBox x:Name="BuildPosition" Width="210" SelectionChanged="BuildPosition_Changed" />
                            <Button Style="{StaticResource PrimaryButton}" Click="SetCurrent_Click" Margin="0,8,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{app:T heroes_set_current, Upper=True}" VerticalAlignment="Center" />
                                    <ov:Icon Glyph="{StaticResource I.ArrowRight}" Size="15" Margin="8,0,0,0" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock x:Name="BuildNote" DockPanel.Dock="Bottom" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                            <TextBlock Style="{StaticResource H1}" Text="{app:T heroes_build, Upper=True}" />
                        </DockPanel>
                        <TextBlock Text="{app:T my_builds}" Style="{StaticResource Eyebrow}" Margin="0,8,0,6" />
                        <ComboBox x:Name="PersonalBuildBox" SelectionChanged="PersonalBuild_Changed" />
                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="{app:T my_new}" Click="NewBuild_Click" />
                            <Button x:Name="EditBuildButton" Content="{app:T my_edit}" Click="EditBuild_Click" />
                            <Button x:Name="DeleteBuildButton" Content="{app:T my_delete}" Click="DeleteBuild_Click" />
                            <Button Style="{StaticResource PrimaryButton}" Content="{app:T my_use}" Click="SetCurrent_Click" />
                        </WrapPanel>
                        <TextBlock x:Name="PersonalBuildStatus" Style="{StaticResource MutedText}" Margin="0,4,0,12" />
                        <TextBlock x:Name="PersonalBuildNotes" Style="{StaticResource Value}" Margin="0,0,0,12" Visibility="Collapsed" />
                        <StackPanel x:Name="BuildPanel" />
                    </StackPanel>
                </Border>

                <!-- Личные заметки к герою -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="{app:T notes_title, Upper=True}" />
                        <TextBlock Text="{app:T notes_hint}" Style="{StaticResource MutedText}" Margin="0,0,0,8" />
                        <TextBox x:Name="NoteBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" MaxHeight="160"
                                 VerticalScrollBarVisibility="Auto" MaxLength="2000" />
                        <DockPanel Margin="0,8,0,0">
                            <Button DockPanel.Dock="Left" Style="{StaticResource PrimaryButton}" Content="{app:T notes_save, Upper=True}" Click="SaveNote_Click" />
                            <Button DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Content="{app:T notes_clear, Upper=True}" Click="ClearNote_Click" />
                            <TextBlock x:Name="NoteStatus" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}" Margin="0,0,8,16">
                        <StackPanel>
                            <TextBlock Style="{StaticResource H2}" Text="{app:T heroes_counters, Upper=True}" />
                            <TextBlock Text="{app:T heroes_counters_note}" Style="{StaticResource MutedText}" Margin="0,0,0,10" />
                            <StackPanel x:Name="CounterPanel" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,16">
                        <StackPanel>
                            <TextBlock Style="{StaticResource H2}" Text="{app:T heroes_tips, Upper=True}" />
                            <StackPanel x:Name="TipsPanel" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
