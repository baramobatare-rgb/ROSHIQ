<UserControl x:Class="Roshiq.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:Roshiq.App"
             xmlns:ov="clr-namespace:Roshiq.Overlay;assembly=Roshiq.Overlay">
    <UserControl.Resources>
        <Style x:Key="TileValue" TargetType="TextBlock" BasedOn="{StaticResource BigValue}">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Margin" Value="0,2,0,4" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,6,20">

            <!-- Уведомления: новый патч / новая версия ROSHIQ -->
            <Border x:Name="NoticeCard" Style="{StaticResource Card}" BorderBrush="{DynamicResource Warning}" Visibility="Collapsed" Padding="22,14">
                <DockPanel>
                    <ov:Icon DockPanel.Dock="Left" Glyph="{StaticResource I.Alert}" Size="18" Brush="{DynamicResource Warning}" Margin="0,1,12,0" VerticalAlignment="Top" />
                    <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Button Content="{app:T dash_notice_open, Upper=True}" Click="NoticeOpen_Click" />
                        <Button x:Name="NoticeDismiss" Style="{StaticResource GhostButton}" Content="{app:T dash_notice_dismiss, Upper=True}" Click="NoticeDismiss_Click" />
                    </WrapPanel>
                    <TextBlock x:Name="NoticeText" Style="{StaticResource Value}" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!-- Профиль Steam -->
            <Border x:Name="ProfileCard" Style="{StaticResource Card}" Padding="22,14">
                <DockPanel>
                    <Border x:Name="ProfileAvatar" DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="8" Margin="0,0,14,0"
                            Background="{DynamicResource Panel3}" VerticalAlignment="Center">
                        <ov:Icon x:Name="ProfileAvatarIcon" Glyph="{StaticResource I.Shield}" Size="16" Brush="{DynamicResource Faint}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Button x:Name="ProfileButton" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Click="ProfileOpen_Click" VerticalAlignment="Center" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="ProfileName" Style="{StaticResource Value}" FontWeight="SemiBold" />
                        <TextBlock x:Name="ProfileSub" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Цель на игру -->
            <Border x:Name="GoalCard" Style="{StaticResource Card}" Visibility="Collapsed" Padding="22,14">
                <DockPanel>
                    <ov:Icon DockPanel.Dock="Left" Glyph="{StaticResource I.Spark}" Size="18" Brush="{DynamicResource Accent}" Margin="0,1,12,0" VerticalAlignment="Top" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{app:T goal_open, Upper=True}" Click="GoalOpen_Click" VerticalAlignment="Center" />
                    <StackPanel>
                        <TextBlock Style="{StaticResource Eyebrow}" Text="{app:T goal_next_game, Upper=True}" Margin="0,0,0,2" />
                        <TextBlock x:Name="GoalLine" Style="{StaticResource Value}" TextWrapping="Wrap" />
                        <TextBlock x:Name="GoalSub" Style="{StaticResource MutedText}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Главный блок: состояние игры + последний герой -->
            <Border Style="{StaticResource Card}" Padding="28,26">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="300" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,28,0">
                        <TextBlock x:Name="HeroEyebrow" Style="{StaticResource Eyebrow}" />
                        <TextBlock x:Name="Headline" Style="{StaticResource Display}" FontSize="34" />
                        <TextBlock x:Name="HeadlineSub" Style="{StaticResource MutedText}" FontSize="13.5" Margin="0,8,0,14" MaxWidth="620" HorizontalAlignment="Left" />
                        <!-- Что важно прямо сейчас: таймеры и золото в матче, сводка в драфте, итог прошлой игры -->
                        <StackPanel x:Name="FocusPanel" Margin="0,0,0,16" MaxWidth="620" HorizontalAlignment="Left" />
                        <WrapPanel>
                            <Button Style="{StaticResource PrimaryButton}" Click="GoDraft_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{app:T dash_go_draft, Upper=True}" VerticalAlignment="Center" />
                                    <ov:Icon Glyph="{StaticResource I.ArrowRight}" Size="15" Margin="8,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Click="GoBuild_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{app:T dash_go_build, Upper=True}" VerticalAlignment="Center" />
                                    <ov:Icon Glyph="{StaticResource I.ArrowRight}" Size="15" Margin="8,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Click="ToggleOverlay_Click">
                                <StackPanel Orientation="Horizontal">
                                    <ov:Icon Glyph="{StaticResource I.Eye}" Size="15" Margin="0,0,8,0" />
                                    <TextBlock Text="{app:T dash_toggle_overlay, Upper=True}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="TestModeButton" Style="{StaticResource GhostButton}" Click="TestMode_Click" />
                        </WrapPanel>
                    </StackPanel>

                    <Border Grid.Column="1" Style="{StaticResource InnerCard}" Padding="20,18">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Eyebrow}" Text="{app:T dash_current, Upper=True}" />
                            <ContentControl x:Name="HeroPortraitHost" Focusable="False" HorizontalAlignment="Left" Margin="0,2,0,10" />
                            <TextBlock x:Name="HeroName" Style="{StaticResource BigValue}" FontSize="24" />
                            <TextBlock x:Name="HeroMeta" Style="{StaticResource MutedText}" Margin="0,4,0,14" />
                            <Border Height="1" Background="{DynamicResource Line}" Margin="0,0,0,14" />
                            <TextBlock Style="{StaticResource Eyebrow}" Text="{app:T dash_next_item, Upper=True}" />
                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="NextItemIcon" Width="44" Height="32" CornerRadius="5" Margin="0,0,12,0"
                                        Visibility="Collapsed" VerticalAlignment="Center" SnapsToDevicePixels="True" />
                                <TextBlock x:Name="NextItem" Grid.Column="1" Style="{StaticResource Value}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock x:Name="NextItemWhy" Style="{StaticResource MutedText}" Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Блок состояния (нет подключения / ошибка) -->
            <Border x:Name="StateCard" Style="{StaticResource Card}" Visibility="Collapsed">
                <ContentControl x:Name="StateHost" Focusable="False" />
            </Border>

            <!-- Показатели -->
            <UniformGrid Columns="4">
                <Border Style="{StaticResource Card}" Margin="0,0,8,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Eyebrow}"><Run Text="01 / " Foreground="{DynamicResource Accent}" /><Run Text="DOTA 2" /></TextBlock>
                        <TextBlock x:Name="GameValue" Style="{StaticResource TileValue}" />
                        <TextBlock x:Name="GameStatus" Style="{StaticResource MutedText}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="8,0,8,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Eyebrow}"><Run Text="02 / " Foreground="{DynamicResource Accent}" /><Run Text="GSI" /></TextBlock>
                        <TextBlock x:Name="GsiValue" Style="{StaticResource TileValue}" />
                        <TextBlock x:Name="GsiStatus" Style="{StaticResource MutedText}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="8,0,8,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Eyebrow}"><Run Text="03 / " Foreground="{DynamicResource Accent}" /><Run Text="{app:T dash_overlay, Upper=True}" /></TextBlock>
                        <TextBlock x:Name="OverlayValue" Style="{StaticResource TileValue}" />
                        <TextBlock x:Name="OverlayStatus" Style="{StaticResource MutedText}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="8,0,0,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Eyebrow}"><Run Text="04 / " Foreground="{DynamicResource Accent}" /><Run Text="{app:T dash_mode, Upper=True}" /></TextBlock>
                        <TextBlock x:Name="ModeValue" Style="{StaticResource TileValue}" />
                        <TextBlock x:Name="ContextHint" Style="{StaticResource MutedText}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Нагрузка и журнал -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Eyebrow}"><Run Text="05 / " Foreground="{DynamicResource Accent}" /><Run Text="{app:T dash_perf, Upper=True}" /></TextBlock>
                    <TextBlock x:Name="Perf" Style="{StaticResource Value}" FontFamily="{StaticResource MonoFont}" FontSize="12.5" />
                    <TextBlock x:Name="VisionStatus" Style="{StaticResource MutedText}" Margin="0,6,0,8" />
                    <Expander Header="{app:T dash_log, Upper=True}" FontFamily="{StaticResource DisplayFont}">
                        <TextBox x:Name="LogBox" IsReadOnly="True" Height="170" Margin="0,8,0,0" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                 VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" />
                    </Expander>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
