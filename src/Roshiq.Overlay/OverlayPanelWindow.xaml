<Window x:Class="Roshiq.Overlay.OverlayPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ROSHIQ Overlay"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" Focusable="False"
        ResizeMode="NoResize" SizeToContent="Manual"
        FontFamily="Segoe UI Variable Text, Segoe UI" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Width="340" Height="300" MinWidth="160" MinHeight="60">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <!-- Цвета панели — фиксированные тёмные; акцент берётся из темы приложения (DynamicResource Accent) -->
        <SolidColorBrush x:Key="PanelBg" Color="#EB0C0E0D" />
        <SolidColorBrush x:Key="PanelLine" Color="#2C332E" />
        <SolidColorBrush x:Key="RowBg" Color="#B3191E1B" />
        <SolidColorBrush x:Key="TextMain" Color="#F5F7F5" />
        <SolidColorBrush x:Key="TextMuted" Color="#8E948E" />
        <SolidColorBrush x:Key="TextFaint" Color="#5E655F" />
        <SolidColorBrush x:Key="Urgent" Color="#FFC857" />
        <FontFamily x:Key="OvDisplay">Bahnschrift, Segoe UI</FontFamily>
        <FontFamily x:Key="OvMono">Cascadia Mono, Consolas</FontFamily>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="FontFamily" Value="{StaticResource OvDisplay}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="1,10,0,6" />
        </Style>
        <Style x:Key="KeyCap" TargetType="Border">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelLine}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>

        <DataTemplate x:Key="RowTemplate">
            <Border Background="{StaticResource RowBg}" CornerRadius="8" Padding="10,7" Margin="0,0,0,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- иконка предмета / портрет героя -->
                    <Border x:Name="RowIcon" Width="30" Height="22" CornerRadius="4" Margin="0,1,9,0" VerticalAlignment="Top">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding Icon}" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextMain}" FontWeight="SemiBold" FontSize="12.5" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Detail}" Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding Badge}" Foreground="{DynamicResource Accent}" FontFamily="{StaticResource OvDisplay}"
                               FontWeight="SemiBold" FontSize="10.5" Margin="8,1,0,0" VerticalAlignment="Top" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                    <Setter TargetName="RowIcon" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="Root" CornerRadius="12" Background="{StaticResource PanelBg}" BorderThickness="1" BorderBrush="{StaticResource PanelLine}">
        <!-- 0.24: в компактном режиме карточка по высоте содержимого, ниже окно прозрачное -->
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="VerticalAlignment" Value="Top" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Expanded}" Value="True">
                        <Setter Property="VerticalAlignment" Value="Stretch" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid x:Name="ContentGrid" Margin="14,11,14,11">
                <Grid.LayoutTransform>
                    <ScaleTransform x:Name="ContentScale" ScaleX="1" ScaleY="1" />
                </Grid.LayoutTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- POS 5 / СБОРКА                 12:34 -->
                <DockPanel Grid.Row="0">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding SubHeader}" Foreground="{StaticResource TextMuted}"
                               FontFamily="{StaticResource OvMono}" FontSize="10.5" VerticalAlignment="Center" />
                    <Image DockPanel.Dock="Left" Source="{DynamicResource AppMark}" Width="14" Height="14" Margin="0,0,7,0"
                           VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="{Binding Header}" Foreground="{StaticResource TextMuted}" FontFamily="{StaticResource OvDisplay}"
                               FontWeight="SemiBold" FontSize="10.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>

                <!-- Главная рекомендация с акцентным индикатором, ниже — золото и блок «Скоро» (0.24) -->
                <StackPanel Grid.Row="1">
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- портрет героя с индикатором новой рекомендации в углу -->
                    <Grid VerticalAlignment="Top" Margin="0,1,10,0">
                        <Border x:Name="Portrait" Width="50" Height="28" CornerRadius="5">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding HeroPortrait}" Stretch="UniformToFill" />
                            </Border.Background>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HeroPortrait}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <Ellipse x:Name="PulseDot" Width="8" Height="8" Fill="{DynamicResource Accent}" Stroke="{StaticResource PanelBg}" StrokeThickness="1.5"
                                 HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,-3,0" />
                    </Grid>
                    <StackPanel x:Name="MainBlock" Grid.Column="1">
                        <StackPanel.RenderTransform>
                            <TranslateTransform x:Name="MainShift" />
                        </StackPanel.RenderTransform>
                        <TextBlock Text="{Binding MainTitle}" Foreground="{StaticResource TextMain}" FontFamily="{StaticResource OvDisplay}"
                                   FontWeight="SemiBold" FontSize="15.5" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding MainDetail}" Foreground="{StaticResource TextMuted}" FontSize="11.5" TextWrapping="Wrap"
                                   MaxHeight="46" TextTrimming="WordEllipsis" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>

                <!-- золото до следующего предмета -->
                <Grid x:Name="GoldBar" Margin="0,9,0,0" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding GoldValue}" Foreground="{StaticResource TextMain}" FontFamily="{StaticResource OvDisplay}"
                                   FontWeight="SemiBold" FontSize="12" Margin="8,0,0,0" />
                        <TextBlock Text="{Binding GoldTitle}" Foreground="{StaticResource TextMuted}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <Border Grid.Row="1" Height="4" CornerRadius="2" Background="#26FFFFFF" Margin="0,5,0,0">
                        <Border x:Name="GoldFill" CornerRadius="2" Background="{DynamicResource Accent}" HorizontalAlignment="Stretch" RenderTransformOrigin="0,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="GoldScale" ScaleX="0" ScaleY="1" />
                            </Border.RenderTransform>
                        </Border>
                    </Border>
                </Grid>

                <!-- «Скоро»: ближайшие события по строкам -->
                <StackPanel Margin="0,10,0,0" Visibility="{Binding HasTimers, Converter={StaticResource BoolToVis}}">
                    <Border Height="1" Background="{StaticResource PanelLine}" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal" Margin="1,0,0,5">
                        <TextBlock Text="{Binding SoonTitle}" Foreground="{StaticResource TextMuted}" FontFamily="{StaticResource OvDisplay}"
                                   FontWeight="SemiBold" FontSize="10.5" VerticalAlignment="Center" />
                        <Ellipse x:Name="TimersText" Width="6" Height="6" Fill="{StaticResource Urgent}" Margin="7,0,0,0" VerticalAlignment="Center"
                                 Visibility="{Binding TimersUrgent, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Timers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="1,0,0,3">
                                    <TextBlock x:Name="Time" DockPanel.Dock="Right" Text="{Binding Time}" FontFamily="{StaticResource OvDisplay}" FontWeight="SemiBold"
                                               FontSize="12.5" Foreground="{StaticResource TextMuted}" Margin="10,0,0,0" />
                                    <TextBlock x:Name="Name" Text="{Binding Name}" Foreground="{StaticResource TextMain}" FontWeight="SemiBold" FontSize="12.5"
                                               TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Ready}" Value="True">
                                        <Setter TargetName="Time" Property="Foreground" Value="{DynamicResource Accent}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Urgent}" Value="True">
                                        <Setter TargetName="Time" Property="Foreground" Value="{StaticResource Urgent}" />
                                        <Setter TargetName="Name" Property="Foreground" Value="{StaticResource Urgent}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                </StackPanel>

                <!-- Подробности (Expanded) -->
                <ScrollViewer Grid.Row="2" Margin="0,4,0,0" VerticalScrollBarVisibility="Hidden"
                              Visibility="{Binding Expanded, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="{Binding Section1Title}" Style="{StaticResource SectionTitle}" />
                        <ItemsControl ItemsSource="{Binding Section1}" ItemTemplate="{StaticResource RowTemplate}" />
                        <TextBlock Text="{Binding Section2Title}" Style="{StaticResource SectionTitle}" />
                        <ItemsControl ItemsSource="{Binding Section2}" ItemTemplate="{StaticResource RowTemplate}" />
                    </StackPanel>
                </ScrollViewer>

                <!-- Управление с клавиатуры: [CTRL+F8 ПОДРОБНЕЕ] [F8 СКРЫТЬ] -->
                <DockPanel Grid.Row="3" Margin="0,9,0,0">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Footer}" Foreground="{StaticResource TextFaint}" FontFamily="{StaticResource OvDisplay}"
                               FontSize="9.5" VerticalAlignment="Center" Visibility="{Binding Expanded, Converter={StaticResource BoolToVis}}" />
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource KeyCap}">
                            <TextBlock Text="{Binding DetailsHint}" Foreground="{StaticResource TextMain}" FontFamily="{StaticResource OvDisplay}" FontWeight="SemiBold" FontSize="9.5" />
                        </Border>
                        <Border Style="{StaticResource KeyCap}">
                            <TextBlock Text="{Binding HideHint}" Foreground="{StaticResource TextMuted}" FontFamily="{StaticResource OvDisplay}" FontWeight="SemiBold" FontSize="9.5" />
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Grid>

            <!-- Рамка режима настройки -->
            <Border CornerRadius="12" BorderThickness="2" BorderBrush="{DynamicResource Accent}" IsHitTestVisible="False"
                    Visibility="{Binding EditMode, Converter={StaticResource BoolToVis}}" />
            <Border VerticalAlignment="Bottom" Margin="8" Padding="8,5" CornerRadius="6" Background="#E6101410" IsHitTestVisible="False"
                    Visibility="{Binding EditMode, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding EditHint}" Foreground="{StaticResource TextMain}" FontFamily="{StaticResource OvDisplay}" FontSize="10.5" TextWrapping="Wrap" />
            </Border>
        </Grid>
    </Border>
</Window>
