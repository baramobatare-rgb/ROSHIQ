<Window x:Class="Roshiq.Overlay.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ov="clr-namespace:Roshiq.Overlay"
        Title="ROSHIQ Reminder"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" Focusable="False"
        FontFamily="Segoe UI Variable Text, Segoe UI" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        ResizeMode="NoResize" Width="320" Height="68">
    <Border x:Name="Root" CornerRadius="12" Background="#EB0C0E0D" BorderBrush="#2C332E" BorderThickness="1" Padding="12,8">
        <Border.RenderTransform>
            <TranslateTransform x:Name="RootShift" />
        </Border.RenderTransform>
        <DockPanel>
            <Border x:Name="IconBox" DockPanel.Dock="Left" Width="32" Height="32" CornerRadius="9" BorderThickness="1" BorderBrush="#2C332E"
                    Margin="0,0,12,0" VerticalAlignment="Center">
                <Image Source="{DynamicResource AppMark}" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="HeaderText" Foreground="#8E948E" FontFamily="Bahnschrift, Segoe UI" FontWeight="SemiBold" FontSize="10" />
                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                    <Ellipse x:Name="Dot" Width="6" Height="6" Fill="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,7,0" />
                    <TextBlock x:Name="Message" Foreground="#F5F7F5" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"
                               TextWrapping="Wrap" MaxWidth="240" />
                </StackPanel>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
