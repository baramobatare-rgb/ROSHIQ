<Window x:Class="Roshiq.Overlay.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ov="clr-namespace:Roshiq.Overlay"
        Title="ROSHIQ Reminder"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" Focusable="False"
        FontFamily="Segoe UI Variable Text, Segoe UI" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        ResizeMode="NoResize" Width="320" Height="96">
    <!-- 0.24: карточка-совет — крупный текст, полоска слева по типу, внизу полоска оставшегося времени -->
    <Border x:Name="Root" CornerRadius="12" Background="#F20C0E0D" BorderBrush="#2C332E" BorderThickness="1" VerticalAlignment="Top">
        <Border.RenderTransform>
            <TranslateTransform x:Name="RootShift" />
        </Border.RenderTransform>
        <Grid>
            <Border x:Name="Stripe" Width="4" HorizontalAlignment="Left" CornerRadius="11,0,0,11" Background="{DynamicResource Accent}" />
            <StackPanel Margin="16,10,14,10">
                <DockPanel>
                    <Border x:Name="IconBox" DockPanel.Dock="Left" Width="22" Height="22" CornerRadius="6" BorderThickness="1" BorderBrush="#2C332E"
                            Margin="0,0,8,0" VerticalAlignment="Center">
                        <Image Source="{DynamicResource AppMark}" Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <Ellipse x:Name="Dot" DockPanel.Dock="Right" Width="7" Height="7" Fill="{DynamicResource Accent}" VerticalAlignment="Center" Margin="8,0,0,0" />
                    <TextBlock x:Name="HeaderText" Foreground="#8E948E" FontFamily="Bahnschrift, Segoe UI" FontWeight="SemiBold" FontSize="10.5"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <TextBlock x:Name="Message" Foreground="#F5F7F5" FontFamily="Bahnschrift, Segoe UI" FontSize="15.5" FontWeight="SemiBold"
                           TextWrapping="Wrap" Margin="0,7,0,0" />
                <Border Height="3" CornerRadius="1.5" Background="#22FFFFFF" Margin="0,10,0,0">
                    <Border x:Name="Countdown" CornerRadius="1.5" Background="{DynamicResource Accent}" RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="CountdownScale" ScaleX="1" ScaleY="1" />
                        </Border.RenderTransform>
                    </Border>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</Window>
