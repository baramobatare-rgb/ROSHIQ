<Window x:Class="Roshiq.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:Roshiq.App"
        xmlns:ov="clr-namespace:Roshiq.Overlay;assembly=Roshiq.Overlay"
        Title="ROSHIQ" Width="1280" Height="820" MinWidth="1040" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True" RenderOptions.BitmapScalingMode="HighQuality"
        Icon="{DynamicResource AppIcon}">
    <Window.Resources>
        <Style x:Key="TabNumber" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Faint}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,1,7,0" />
        </Style>
        <Style x:Key="TabLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Pill" TargetType="Border">
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="11,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
            <Setter Property="Background" Value="{DynamicResource Panel}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="68" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== Верхняя панель ===== -->
        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="32,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Текстовый логотип -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="{DynamicResource AppLogo}" Width="34" Height="34" Margin="0,0,12,0" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel x:Name="BrandWord" Orientation="Horizontal">
                    <TextBlock Text="ROSHI" FontFamily="{StaticResource HeadlineFont}" FontSize="21" FontWeight="Black" VerticalAlignment="Center" />
                    <TextBlock Text="Q" FontFamily="{StaticResource HeadlineFont}" FontSize="21" FontWeight="Black" VerticalAlignment="Center"
                               Foreground="{DynamicResource Accent}" />
                    <!-- Версия — «стикер» в цвете темы, как метки на сайте -->
                    <Border Margin="10,0,0,0" CornerRadius="3" Padding="6,2" VerticalAlignment="Center"
                            Background="{DynamicResource Accent}">
                        <TextBlock x:Name="VersionText" Text="v0.1" FontFamily="{StaticResource DisplayFont}" FontSize="11" FontWeight="ExtraBold"
                                   Foreground="{DynamicResource OnAccent}" />
                    </Border>
                    </StackPanel>
                </StackPanel>

                <!-- Нумерованная навигация -->
                <!-- 6 разделов. При узком окне сначала прячутся подписи справа (ApplyTopBarDensity), и только в крайнем случае
                     навигация уменьшается — так текст меню не мельчает в окне не на весь экран -->
                <Viewbox Grid.Column="1" StretchDirection="DownOnly" Stretch="Uniform" HorizontalAlignment="Center" Margin="20,0">
                <ListBox x:Name="Nav" VerticalAlignment="Stretch"
                         Background="Transparent" BorderThickness="0" Padding="0"
                         ItemContainerStyle="{StaticResource TopTab}" SelectionChanged="Nav_SelectionChanged">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBoxItem Tag="dashboard" Height="66">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource TabLabel}" Text="{app:T sec_dashboard}" /></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="draft" Height="66">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource TabLabel}" Text="{app:T sec_draft}" /></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="build" Height="66">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource TabLabel}" Text="{app:T sec_build}" /></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="assistant" Height="66">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource TabLabel}" Text="{app:T sec_assistant}" /></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="history" Height="66">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource TabLabel}" Text="{app:T sec_history}" /></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="settings" Height="66">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource TabLabel}" Text="{app:T sec_settings}" /></StackPanel>
                    </ListBoxItem>
                </ListBox>
                </Viewbox>

                <!-- Статусы и кнопка настроек -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Обновление программы: всегда на виду; когда вышла новая версия — акцентная кнопка «Обновить до …» -->
                    <Button x:Name="UpdateButton" Style="{StaticResource GhostButton}" Click="Update_Click" Margin="0,0,10,0" Padding="10,7">
                        <StackPanel Orientation="Horizontal">
                            <ov:Icon x:Name="UpdateIcon" Glyph="{StaticResource I.Refresh}" Size="15" VerticalAlignment="Center" />
                            <TextBlock x:Name="UpdateText" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Border x:Name="StatusPill" Style="{StaticResource Pill}" ToolTip="{app:T top_dota_tip}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{DynamicResource Faint}" VerticalAlignment="Center" />
                            <TextBlock x:Name="StatusText" Margin="8,0,0,0" FontFamily="{StaticResource DisplayFont}" FontSize="11.5"
                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="MatchPill" Style="{StaticResource Pill}">
                        <StackPanel Orientation="Horizontal">
                            <ov:Icon Glyph="{StaticResource I.Clock}" Size="14" Brush="{DynamicResource Muted}" VerticalAlignment="Center" />
                            <TextBlock x:Name="MatchText" Margin="7,0,0,0" FontFamily="{StaticResource DisplayFont}" FontSize="11.5"
                                       FontWeight="SemiBold" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource IconButton}" Click="Search_Click" ToolTip="{app:T srch_tooltip}">
                        <ov:Icon Glyph="{StaticResource I.Search}" Size="18" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" Click="Settings_Click" ToolTip="{app:T sec_settings}">
                        <ov:Icon Glyph="{StaticResource I.Sliders}" Size="18" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Заголовок раздела и содержимое ===== -->
        <!-- Контент не шире 1600 px: на широких мониторах он по центру, без пустых полос внутри карточек -->
        <Grid Grid.Row="1" Margin="32,22,32,0" MaxWidth="1600">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="PageNumber" Visibility="Collapsed" Style="{StaticResource PageNumber}" Text="01 /" Margin="0,8,14,0" VerticalAlignment="Top" />
                <!-- Наклонная полоса в цвете темы — тот же знак, что диагональ на сайте -->
                <Border x:Name="PageStripe" Width="9" Height="34" Margin="5,3,16,0" VerticalAlignment="Top" Background="{DynamicResource Accent}"
                        RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <SkewTransform AngleX="-14" />
                    </Border.RenderTransform>
                </Border>
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="PageTitle" Style="{StaticResource Display}" />
                    <TextBlock x:Name="PageSubtitle" Style="{StaticResource MutedText}" FontSize="14" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
            <ContentControl x:Name="Host" Grid.Row="1" Focusable="False" ClipToBounds="True" />
        </Grid>

        <!-- ===== Нижняя строка ===== -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="32,10">
            <DockPanel>
                <Border DockPanel.Dock="Right" CornerRadius="4" Padding="10,4" BorderThickness="1" BorderBrush="{DynamicResource Line}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="ContextDot" Width="6" Height="6" Fill="{DynamicResource Accent}" VerticalAlignment="Center" />
                        <TextBlock x:Name="ContextText" Margin="8,0,0,0" FontFamily="{StaticResource DisplayFont}" FontSize="11"
                                   FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <TextBlock Foreground="{DynamicResource Faint}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Text="{app:T app_disclaimer}" />
            </DockPanel>
        </Border>

        <!-- Мягкое свечение за курсором в цвете темы. Не перехватывает мышь. -->
        <Canvas x:Name="GlowLayer" Grid.RowSpan="3" IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse x:Name="CursorGlow" Width="220" Height="220" Opacity="0" IsHitTestVisible="False" />
        </Canvas>
    </Grid>
</Window>
