<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>Roshiq</AssemblyName>
    <RootNamespace>Roshiq.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\roshiq.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Tesseract" Version="5.2.0" />
    <ProjectReference Include="..\Roshiq.Core\Roshiq.Core.csproj" />
    <ProjectReference Include="..\Roshiq.Data\Roshiq.Data.csproj" />
    <ProjectReference Include="..\Roshiq.Draft\Roshiq.Draft.csproj" />
    <ProjectReference Include="..\Roshiq.Recommendations\Roshiq.Recommendations.csproj" />
    <ProjectReference Include="..\Roshiq.Vision\Roshiq.Vision.csproj" />
    <ProjectReference Include="..\Roshiq.GSI\Roshiq.GSI.csproj" />
    <ProjectReference Include="..\Roshiq.Overlay\Roshiq.Overlay.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\roshiq.ico" />
    <Resource Include="Assets\Brand\**\*.ico;Assets\Brand\**\*.png" />
    <!-- Фон карты смертей: картинка автора проекта (см. Assets\Map\SOURCES.txt), без графики Valve -->
    <Resource Include="Assets\Map\minimap.jpg" />
    <!-- Шрифт заголовков, тот же, что на сайте: Inter Display (SIL OFL 1.1, см. Assets\Fonts\SOURCES.txt) -->
    <Resource Include="Assets\Fonts\*.ttf" />
    <EmbeddedResource Include="Assets\Portraits.zip" />
    <!-- Портреты героев: собирает tools\fetch-hero-art.ps1 (вызывается из build.ps1) -->
    <EmbeddedResource Include="Assets\HeroArt.zip" Condition="Exists('Assets\HeroArt.zip')" />
    <EmbeddedResource Include="Assets\whatsnew.txt" LogicalName="Roshiq.App.Assets.whatsnew.txt" />
    <!-- Иконки предметов: собирает tools\fetch-item-icons.ps1 (вызывается из build.ps1) -->
    <EmbeddedResource Include="Assets\ItemIcons.zip" Condition="Exists('Assets\ItemIcons.zip')" />
    <SplashScreen Include="Assets\Brand\splash.jpg" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\Tessdata\*.traineddata" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="tessdata\%(Filename)%(Extension)" />
    <Content Include="Assets\Tessdata\LICENSE.txt;Assets\Tessdata\SOURCES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="tessdata\%(Filename)%(Extension)" />
  </ItemGroup>
  <!-- The OCR wrapper locates its native DLLs relative to Tesseract.dll; it needs a real on-disk assembly path. -->
  <Target Name="KeepTesseractFilesBesideExe" BeforeTargets="_ComputeFilesToBundle">
    <ItemGroup>
      <ResolvedFileToPublish Update="@(ResolvedFileToPublish)"
        Condition="'%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'Tesseract.dll' Or '%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'tesseract50.dll' Or '%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'leptonica-1.82.0.dll'">
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
