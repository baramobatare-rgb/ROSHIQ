<UserControl x:Class="Roshiq.App.Views.TierListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:Roshiq.App">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,6,20">
            <!-- Позиция и ранги -->
            <DockPanel Margin="0,0,0,14" LastChildFill="False">
                <WrapPanel x:Name="PositionTabs" DockPanel.Dock="Left" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{app:T tier_rank}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="RankBox" Width="190" SelectionChanged="RankBox_SelectionChanged" />
                    <Button x:Name="RefreshButton" Style="{StaticResource GhostButton}" Content="{app:T meta_refresh}" Click="Refresh_Click" Margin="10,0,0,0" />
                </StackPanel>
            </DockPanel>
            <TextBlock x:Name="StatusText" Style="{StaticResource MutedText}" Margin="0,0,0,10" TextWrapping="Wrap" />

            <!-- Контрпики выбранного героя -->
            <Border x:Name="CounterCard" Style="{StaticResource Card}" Margin="0,0,0,14" Visibility="Collapsed">
                <StackPanel x:Name="CounterPanel" />
            </Border>

            <StackPanel x:Name="TiersPanel" />
            <TextBlock Text="{app:T tier_note}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
