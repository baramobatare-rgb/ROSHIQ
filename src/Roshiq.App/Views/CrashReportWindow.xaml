<Window x:Class="Roshiq.App.Views.CrashReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:Roshiq.App"
        Title="ROSHIQ" Icon="{DynamicResource AppIcon}" Width="680" Height="560" MinWidth="520" MinHeight="380"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">
    <Grid Margin="28,24,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="{app:T crash_eyebrow, Upper=True}" Style="{StaticResource Eyebrow}" Foreground="{DynamicResource Red}" />
            <TextBlock Text="{app:T crash_title}" Style="{StaticResource H1}" />
            <TextBlock Text="{app:T crash_hint}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,2,0,12" />
        </StackPanel>
        <TextBox x:Name="ReportText" Grid.Row="1" IsReadOnly="True" TextWrapping="NoWrap" FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" AcceptsReturn="True" />
        <DockPanel Grid.Row="2" Margin="0,16,0,0">
            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="{app:T diag_close, Upper=True}" Click="Close_Click" IsCancel="True" />
            <WrapPanel>
                <Button Style="{StaticResource GhostButton}" Content="{app:T crash_copy, Upper=True}" Click="Copy_Click" />
                <Button Style="{StaticResource GhostButton}" Content="{app:T crash_github, Upper=True}" Click="GitHub_Click" />
                <Button Style="{StaticResource GhostButton}" Content="{app:T diag_logs, Upper=True}" Click="Folder_Click" />
                <TextBlock x:Name="Status" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="8,0,0,0" />
            </WrapPanel>
        </DockPanel>
    </Grid>
</Window>
