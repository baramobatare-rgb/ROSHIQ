<UserControl x:Class="Roshiq.App.Views.NotificationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:Roshiq.App"
             xmlns:ov="clr-namespace:Roshiq.Overlay;assembly=Roshiq.Overlay">
    <UserControl.Resources>
        <Style x:Key="SecField" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="90" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        </Style>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource Card}" Margin="0,0,8,16">
            <StackPanel>
                <TextBlock Style="{StaticResource Eyebrow}"><Run Text="01 / " Foreground="{DynamicResource Accent}" /><Run Text="{app:T asst_reminders, Upper=True}" /></TextBlock>
                <CheckBox x:Name="Enabled" FontWeight="SemiBold" Content="{app:T notif_enabled}" />
                <TextBlock Text="{app:T notif_hint}" Style="{StaticResource MutedText}" Margin="0,2,0,14" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="60" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                    </Grid.RowDefinitions>
                    <CheckBox x:Name="ObsEnabled" Content="{app:T rem_observer}" />
                    <TextBox x:Name="ObsInterval" Grid.Column="1" Style="{StaticResource SecField}" />
                    <TextBlock Grid.Column="2" Text="{app:T notif_sec_short}" Style="{StaticResource RowLabel}" Margin="10,0,0,0" />
                    <CheckBox x:Name="SentryEnabled" Grid.Row="1" Content="{app:T rem_sentry}" />
                    <TextBox x:Name="SentryInterval" Grid.Row="1" Grid.Column="1" Style="{StaticResource SecField}" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{app:T notif_sec_short}" Style="{StaticResource RowLabel}" Margin="10,0,0,0" />
                    <CheckBox x:Name="SmokeEnabled" Grid.Row="2" Content="{app:T rem_smoke}" />
                    <TextBox x:Name="SmokeInterval" Grid.Row="2" Grid.Column="1" Style="{StaticResource SecField}" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="{app:T notif_sec_short}" Style="{StaticResource RowLabel}" Margin="10,0,0,0" />
                    <CheckBox x:Name="ConsEnabled" Grid.Row="3" Content="{app:T rem_consumables}" />
                    <TextBox x:Name="ConsInterval" Grid.Row="3" Grid.Column="1" Style="{StaticResource SecField}" />
                    <TextBlock Grid.Row="3" Grid.Column="2" Text="{app:T notif_sec_short}" Style="{StaticResource RowLabel}" Margin="10,0,0,0" />
                </Grid>
                <Border Height="1" Background="{DynamicResource Line}" Margin="0,14,0,10" />
                <UniformGrid Columns="3">
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="{app:T notif_display}" Style="{StaticResource RowLabel}" TextWrapping="Wrap" />
                        <TextBox x:Name="DisplaySec" Style="{StaticResource SecField}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="{app:T notif_gap}" Style="{StaticResource RowLabel}" TextWrapping="Wrap" />
                        <TextBox x:Name="GapSec" Style="{StaticResource SecField}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{app:T notif_first}" Style="{StaticResource RowLabel}" TextWrapping="Wrap" />
                        <TextBox x:Name="FirstSec" Style="{StaticResource SecField}" />
                    </StackPanel>
                </UniformGrid>
                <WrapPanel Margin="0,14,0,0">
                    <Button Style="{StaticResource PrimaryButton}" Click="Save_Click" Content="{app:T save, Upper=True}" />
                    <Button Click="Test_Click">
                        <StackPanel Orientation="Horizontal">
                            <ov:Icon Glyph="{StaticResource I.Bell}" Size="15" Margin="0,0,8,0" />
                            <TextBlock Text="{app:T notif_test, Upper=True}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
                <TextBlock x:Name="Status" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,16">
            <StackPanel>
                <TextBlock Style="{StaticResource Eyebrow}"><Run Text="02 / " Foreground="{DynamicResource Accent}" /><Run Text="{app:T notif_timer, Upper=True}" /></TextBlock>
                <TextBlock Text="{app:T notif_timer_hint}" Style="{StaticResource MutedText}" Margin="0,0,0,14" />
                <Button x:Name="TimerButton" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="Timer_Click" />
                <Border Height="1" Background="{DynamicResource Line}" Margin="0,16,0,12" />
                <TextBlock Style="{StaticResource Eyebrow}" Text="{app:T notif_next_title, Upper=True}" />
                <StackPanel x:Name="NextPanel" />
                <TextBlock x:Name="NextInfo" Visibility="Collapsed" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
