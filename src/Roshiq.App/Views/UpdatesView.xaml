<UserControl x:Class="Roshiq.App.Views.UpdatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:Roshiq.App"
             xmlns:v="clr-namespace:Roshiq.App.Views"
             xmlns:ov="clr-namespace:Roshiq.Overlay;assembly=Roshiq.Overlay">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,6,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- База -->
                <Border Style="{StaticResource Card}" Margin="0,0,8,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Eyebrow}"><Run Text="01 / " Foreground="{DynamicResource Accent}" /><Run Text="{app:T upd_data, Upper=True}" /></TextBlock>
                        <TextBlock x:Name="DataInfo" Style="{StaticResource Value}" />
                        <TextBlock x:Name="DataWarnings" Style="{StaticResource MutedText}" Margin="0,8,0,0" />
                        <WrapPanel Margin="0,12,0,0">
                            <Button Style="{StaticResource PrimaryButton}" Click="Reload_Click">
                                <StackPanel Orientation="Horizontal">
                                    <ov:Icon Glyph="{StaticResource I.Refresh}" Size="15" Margin="0,0,8,0" />
                                    <TextBlock Text="{app:T upd_reload, Upper=True}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Content="{app:T upd_open_data, Upper=True}" Click="OpenData_Click" />
                            <Button Style="{StaticResource GhostButton}" Content="{app:T upd_export_data, Upper=True}" Click="ExportData_Click" />
                        </WrapPanel>
                        <TextBlock Text="{app:T upd_data_hint}" Style="{StaticResource MutedText}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <!-- Статистика -->
                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Eyebrow}"><Run Text="02 / " Foreground="{DynamicResource Accent}" /><Run Text="{app:T upd_stats, Upper=True}" /><InlineUIContainer BaselineAlignment="Center"><v:HelpTip Text="{app:T help_online}" /></InlineUIContainer></TextBlock>
                        <TextBlock x:Name="StatsInfo" Style="{StaticResource Value}" />
                        <CheckBox x:Name="AllowOnline" Content="{app:T upd_allow_online}" Margin="0,10,0,4" Checked="AllowOnline_Changed" Unchecked="AllowOnline_Changed" />
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="{app:T upd_api_key}" Foreground="{DynamicResource Muted}" FontSize="12.5" />
                                <PasswordBox x:Name="ApiKey" Margin="0,3,0,3" />
                            </StackPanel>
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock Text="{app:T upd_min_games}" Foreground="{DynamicResource Muted}" FontSize="12.5" />
                                <TextBox x:Name="MinGames" FontFamily="{StaticResource MonoFont}" />
                            </StackPanel>
                        </UniformGrid>
                        <WrapPanel Margin="0,10,0,0">
                            <Button x:Name="RefreshStats" Style="{StaticResource PrimaryButton}" Click="RefreshStats_Click">
                                <StackPanel Orientation="Horizontal">
                                    <ov:Icon Glyph="{StaticResource I.Database}" Size="15" Margin="0,0,8,0" />
                                    <TextBlock Text="{app:T upd_refresh_stats, Upper=True}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="CancelStats" Content="{app:T cancel, Upper=True}" Click="CancelStats_Click" IsEnabled="False" />
                            <Button Style="{StaticResource GhostButton}" Content="{app:T upd_clear_stats, Upper=True}" Click="ClearStats_Click" />
                            <Button Style="{StaticResource GhostButton}" Content="{app:T save, Upper=True}" Click="SaveKey_Click" />
                        </WrapPanel>
                        <ProgressBar x:Name="StatsProgress" Margin="0,10,0,0" Maximum="1" />
                        <ContentControl x:Name="StatsState" Focusable="False" Margin="0,6,0,0" />
                        <TextBlock x:Name="StatsStatus" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                        <TextBlock Text="{app:T upd_stats_hint}" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Актуальность данных -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Style="{StaticResource Eyebrow}"><Run Text="08 / " Foreground="{DynamicResource Accent}" /><Run Text="{app:T fresh_title, Upper=True}" /><InlineUIContainer BaselineAlignment="Center"><v:HelpTip Text="{app:T help_data}" /></InlineUIContainer></TextBlock>
                    <TextBlock x:Name="FreshSource" Style="{StaticResource Value}" TextWrapping="Wrap" />
                    <StackPanel x:Name="FreshAudit" Margin="0,8,0,0" />
                    <TextBlock x:Name="FreshMessage" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <CheckBox x:Name="AutoDataBox" Content="{app:T fresh_auto_data}" Checked="Fresh_Changed" Unchecked="Fresh_Changed" Margin="0,10,0,4" />
                    <CheckBox x:Name="AutoMatchupsBox" Content="{app:T fresh_auto_matchups}" Checked="Fresh_Changed" Unchecked="Fresh_Changed" Margin="0,0,0,8" />
                    <WrapPanel>
                        <Button x:Name="FreshCheckButton" Style="{StaticResource PrimaryButton}" Content="{app:T fresh_check, Upper=True}" Click="FreshCheck_Click" />
                        <Button x:Name="FreshResetButton" Style="{StaticResource GhostButton}" Content="{app:T fresh_reset, Upper=True}" Click="FreshReset_Click" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- История и сеть -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Margin="0,0,8,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Eyebrow}"><Run Text="03 / " Foreground="{DynamicResource Accent}" /><Run Text="{app:T upd_history, Upper=True}" /></TextBlock>
                        <TextBox x:Name="History" IsReadOnly="True" Height="150" FontFamily="{StaticResource MonoFont}" FontSize="11" VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Eyebrow}"><Run Text="04 / " Foreground="{DynamicResource Accent}" /><Run Text="{app:T upd_network, Upper=True}" /></TextBlock>
                        <TextBox x:Name="Network" IsReadOnly="True" Height="150" FontFamily="{StaticResource MonoFont}" FontSize="11" VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Патч и цены, обновления приложения -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Margin="0,0,8,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Eyebrow}"><Run Text="05 / " Foreground="{DynamicResource Accent}" /><Run Text="{app:T upd_patch, Upper=True}" /></TextBlock>
                        <TextBlock x:Name="PatchInfo" Style="{StaticResource Value}" />
                        <TextBlock x:Name="CostInfo" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                        <CheckBox x:Name="AutoCheck" Content="{app:T upd_auto_check}" Margin="0,10,0,0" Checked="AutoCheck_Changed" Unchecked="AutoCheck_Changed" />
                        <WrapPanel Margin="0,10,0,0">
                            <Button x:Name="CheckOnline" Style="{StaticResource PrimaryButton}" Click="CheckOnline_Click">
                                <StackPanel Orientation="Horizontal">
                                    <ov:Icon Glyph="{StaticResource I.Refresh}" Size="15" Margin="0,0,8,0" />
                                    <TextBlock Text="{app:T upd_check_now, Upper=True}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="AckPatch" Style="{StaticResource GhostButton}" Content="{app:T upd_patch_ack, Upper=True}" Click="AckPatch_Click" />
                        </WrapPanel>
                        <TextBlock x:Name="OnlineStatus" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                        <TextBlock Text="{app:T upd_patch_hint}" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Eyebrow}"><Run Text="06 / " Foreground="{DynamicResource Accent}" /><Run Text="{app:T upd_app, Upper=True}" /></TextBlock>
                        <TextBlock x:Name="AppVersionInfo" Style="{StaticResource Value}" />
                        <TextBlock Text="{app:T upd_repo}" Foreground="{DynamicResource Muted}" FontSize="12.5" Margin="0,10,0,0" />
                        <DockPanel Margin="0,3,0,0">
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{app:T save, Upper=True}" Click="SaveRepo_Click" Margin="8,0,0,0" />
                            <TextBox x:Name="RepoBox" FontFamily="{StaticResource MonoFont}" VerticalContentAlignment="Center" />
                        </DockPanel>
                        <WrapPanel Margin="0,10,0,0">
                            <Button x:Name="CheckApp" Click="CheckApp_Click" Content="{app:T upd_app_check, Upper=True}" />
                            <Button x:Name="InstallApp" Style="{StaticResource PrimaryButton}" Click="InstallApp_Click" IsEnabled="False">
                                <StackPanel Orientation="Horizontal">
                                    <ov:Icon Glyph="{StaticResource I.ArrowRight}" Size="15" Margin="0,0,8,0" />
                                    <TextBlock Text="{app:T upd_app_install, Upper=True}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="OpenRelease" Style="{StaticResource GhostButton}" Content="{app:T upd_app_page, Upper=True}" Click="OpenRelease_Click" IsEnabled="False" />
                        </WrapPanel>
                        <ProgressBar x:Name="AppProgress" Margin="0,10,0,0" Maximum="1" Visibility="Collapsed" />
                        <TextBlock x:Name="AppStatus" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                        <TextBlock Text="{app:T upd_app_hint}" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Изменения патча для героев пула -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Eyebrow}"><Run Text="07 / " Foreground="{DynamicResource Accent}" /><Run Text="{app:T pn_title, Upper=True}" /></TextBlock>
                    <TextBlock x:Name="PatchNotesInfo" Style="{StaticResource MutedText}" Margin="0,0,0,8" />
                    <StackPanel x:Name="PatchNotesPanel" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
