<Window x:Class="Roshiq.App.Views.PostMatchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:Roshiq.App"
        Title="ROSHIQ" Icon="{DynamicResource AppIcon}" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">
    <StackPanel Margin="28,24,28,22">
        <DockPanel>
            <Border x:Name="PortraitBox" DockPanel.Dock="Left" Width="88" Height="50" CornerRadius="8" Margin="0,0,16,0" ClipToBounds="True"
                    Background="{DynamicResource Panel3}">
                <Image x:Name="Portrait" Stretch="UniformToFill" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="ResultText" Style="{StaticResource Eyebrow}" />
                <TextBlock x:Name="HeroText" Style="{StaticResource H1}" Margin="0" />
                <TextBlock x:Name="StatsText" Style="{StaticResource MutedText}" />
            </StackPanel>
        </DockPanel>

        <TextBlock Text="{app:T pm_good, Upper=True}" Style="{StaticResource Eyebrow}" Foreground="{DynamicResource Success}" Margin="0,20,0,6" />
        <StackPanel x:Name="GoodPanel" />

        <StackPanel x:Name="MistakeBlock">
            <TextBlock Text="{app:T pm_fix, Upper=True}" Style="{StaticResource Eyebrow}" Foreground="{DynamicResource Warning}" Margin="0,16,0,6" />
            <Border Style="{StaticResource Callout}" BorderBrush="{DynamicResource Warning}" Margin="0">
                <TextBlock x:Name="MistakeText" TextWrapping="Wrap" Foreground="{DynamicResource Text}" FontSize="14" />
            </Border>
        </StackPanel>

        <StackPanel x:Name="StoryBlock" Margin="0,16,0,0">
            <TextBlock Text="{app:T pm_story_title, Upper=True}" Style="{StaticResource Eyebrow}" Foreground="{DynamicResource Accent}" Margin="0,0,0,6" />
            <StackPanel x:Name="StoryPanel" />
        </StackPanel>

        <StackPanel x:Name="FeedbackBlock" Margin="0,16,0,0">
            <TextBlock Text="{app:T pm_feedback_title, Upper=True}" Style="{StaticResource Eyebrow}" Foreground="{DynamicResource Accent}" Margin="0,0,0,6" />
            <StackPanel x:Name="FeedbackPanel" />
        </StackPanel>

        <StackPanel x:Name="DeferredBlock" Margin="0,16,0,0">
            <TextBlock Text="{app:T pm_deferred_title, Upper=True}" Style="{StaticResource Eyebrow}" Foreground="{DynamicResource Accent}" Margin="0,0,0,6" />
            <StackPanel x:Name="DeferredPanel" />
        </StackPanel>

        <TextBlock Text="{app:T pm_next_goal, Upper=True}" Style="{StaticResource Eyebrow}" Foreground="{DynamicResource Accent}" Margin="0,16,0,6" />
        <Border Style="{StaticResource Callout}" BorderBrush="{DynamicResource Accent}" Margin="0"><TextBlock x:Name="NextGoalText" Style="{StaticResource Value}" /></Border>
        <TextBlock x:Name="BasisText" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,14,0,0" />
        <DockPanel Margin="0,18,0,0">
            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{app:T diag_close}" Click="Close_Click" IsCancel="True" />
            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="{app:T pm_more}" Click="More_Click" IsDefault="True" />
            <CheckBox x:Name="DontShow" Content="{app:T pm_dont_show}" VerticalAlignment="Center" />
        </DockPanel>
    </StackPanel>
</Window>
