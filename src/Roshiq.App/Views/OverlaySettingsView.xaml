<UserControl x:Class="Roshiq.App.Views.OverlaySettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:Roshiq.App"
             xmlns:v="clr-namespace:Roshiq.App.Views"
             xmlns:ov="clr-namespace:Roshiq.Overlay;assembly=Roshiq.Overlay">
    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ValueLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Margin" Value="10,0,0,0" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,6,20">

            <!-- Режим -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Eyebrow}"><Run Text="{app:T ov_mode, Upper=True}" /><InlineUIContainer BaselineAlignment="Center"><v:HelpTip Text="{app:T help_overlay}" /></InlineUIContainer></TextBlock>
                    <WrapPanel>
                        <RadioButton x:Name="ModeMinimal" Style="{StaticResource Segment}" GroupName="Mode" Content="{app:T ovmode_minimal}" Checked="Mode_Checked" />
                        <RadioButton x:Name="ModeExpanded" Style="{StaticResource Segment}" GroupName="Mode" Content="{app:T ovmode_expanded}" Checked="Mode_Checked" />
                        <RadioButton x:Name="ModeHidden" Style="{StaticResource Segment}" GroupName="Mode" Content="{app:T ovmode_hidden}" Checked="Mode_Checked" />
                    </WrapPanel>
                    <TextBlock Text="{app:T ov_mode_hint}" Style="{StaticResource MutedText}" Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <!-- Положение, размер, масштаб, прозрачность + схема экрана -->
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="340" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Style="{StaticResource Eyebrow}"><Run Text="{app:T ov_position, Upper=True}" /></TextBlock>
                        <TextBlock Text="{app:T ov_position_hint}" Style="{StaticResource MutedText}" Margin="0,0,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Text="X" Style="{StaticResource FieldLabel}" />
                            <Slider x:Name="XSlider" Grid.Column="1" Minimum="0" Maximum="1" ValueChanged="Geometry_Changed" Margin="0,4" />
                            <TextBlock x:Name="XText" Grid.Column="2" Style="{StaticResource ValueLabel}" />
                            <TextBlock Grid.Row="1" Text="Y" Style="{StaticResource FieldLabel}" />
                            <Slider x:Name="YSlider" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="1" ValueChanged="Geometry_Changed" Margin="0,4" />
                            <TextBlock x:Name="YText" Grid.Row="1" Grid.Column="2" Style="{StaticResource ValueLabel}" />
                            <TextBlock Grid.Row="2" Text="{app:T ov_width}" Style="{StaticResource FieldLabel}" />
                            <Slider x:Name="WSlider" Grid.Row="2" Grid.Column="1" Minimum="0.08" Maximum="0.45" ValueChanged="Geometry_Changed" Margin="0,4" />
                            <TextBlock x:Name="WText" Grid.Row="2" Grid.Column="2" Style="{StaticResource ValueLabel}" />
                            <TextBlock Grid.Row="3" Text="{app:T ov_height}" Style="{StaticResource FieldLabel}" />
                            <Slider x:Name="HSlider" Grid.Row="3" Grid.Column="1" Minimum="0.05" Maximum="0.7" ValueChanged="Geometry_Changed" Margin="0,4" />
                            <TextBlock x:Name="HText" Grid.Row="3" Grid.Column="2" Style="{StaticResource ValueLabel}" />
                            <TextBlock Grid.Row="4" Text="{app:T ov_scale}" Style="{StaticResource FieldLabel}" />
                            <Slider x:Name="ScaleSlider" Grid.Row="4" Grid.Column="1" Minimum="0.8" Maximum="2" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="Geometry_Changed" Margin="0,4" />
                            <TextBlock x:Name="ScaleText" Grid.Row="4" Grid.Column="2" Style="{StaticResource ValueLabel}" />
                            <TextBlock Grid.Row="5" Text="{app:T ov_opacity}" Style="{StaticResource FieldLabel}" />
                            <Slider x:Name="OpacitySlider" Grid.Row="5" Grid.Column="1" Minimum="0.2" Maximum="1" ValueChanged="Geometry_Changed" Margin="0,4" />
                            <TextBlock x:Name="OpacityText" Grid.Row="5" Grid.Column="2" Style="{StaticResource ValueLabel}" />
                        </Grid>
                        <WrapPanel Margin="0,12,0,0">
                            <Button x:Name="EditButton" Style="{StaticResource PrimaryButton}" Click="Edit_Click" />
                            <Button x:Name="TestButton" Click="Test_Click" />
                            <Button Style="{StaticResource GhostButton}" Content="{app:T ov_reset}" Click="Reset_Click" />
                        </WrapPanel>
                        <CheckBox x:Name="AutoScaleBox" Content="{app:T ov_autoscale}" ToolTip="{app:T ov_autoscale_hint}" Checked="AutoScale_Changed" Unchecked="AutoScale_Changed" Margin="0,10,0,0" />
                        <TextBlock x:Name="AutoScaleText" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="24,2,0,0" />
                        <CheckBox x:Name="SnapBox" Content="{app:T ov_snap}" Checked="Snap_Changed" Unchecked="Snap_Changed" Margin="0,10,0,0" />
                        <DockPanel Margin="0,8,0,0">
                            <Button x:Name="ResetLayoutsButton" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{app:T ov_layouts_reset}" Click="ResetLayouts_Click" />
                            <TextBlock x:Name="LayoutsText" Style="{StaticResource MutedText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </DockPanel>
                    </StackPanel>

                    <!-- Схема экрана 16:9: запретные зоны HUD и положение панели -->
                    <StackPanel Grid.Column="1">
                        <TextBlock Style="{StaticResource Eyebrow}" Text="{app:T ov_preview, Upper=True}" />
                        <Border CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource LineStrong}" Background="{DynamicResource Bg}"
                                Width="320" Height="180" HorizontalAlignment="Left" ClipToBounds="True">
                            <Canvas x:Name="Preview" Width="320" Height="180" />
                        </Border>
                        <TextBlock Text="{app:T ov_safezone_hint}" Style="{StaticResource MutedText}" Margin="0,10,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Горячие клавиши -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Eyebrow}"><Run Text="{app:T ov_hotkeys, Upper=True}" /></TextBlock>
                    <UniformGrid Columns="4">
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="{app:T ov_hotkey_toggle}" Style="{StaticResource FieldLabel}" />
                            <v:HotkeyBox x:Name="ToggleHotkey" FontFamily="{StaticResource MonoFont}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="{app:T ov_hotkey_details}" Style="{StaticResource FieldLabel}" />
                            <v:HotkeyBox x:Name="DetailsHotkey" FontFamily="{StaticResource MonoFont}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="{app:T ov_hotkey_edit}" Style="{StaticResource FieldLabel}" />
                            <v:HotkeyBox x:Name="EditHotkey" FontFamily="{StaticResource MonoFont}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{app:T ov_hotkey_roshan}" Style="{StaticResource FieldLabel}" />
                            <v:HotkeyBox x:Name="RoshanHotkey" FontFamily="{StaticResource MonoFont}" />
                        </StackPanel>
                    </UniformGrid>
                    <DockPanel Margin="0,10,0,0">
                        <Button DockPanel.Dock="Left" Content="{app:T save}" Click="SaveHotkeys_Click" />
                        <Button DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Content="{app:T hk_reset}" Click="ResetHotkeys_Click" Margin="8,0,0,0" />
                        <TextBlock x:Name="HotkeyStatus" Style="{StaticResource MutedText}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="12,0,0,0" />
                    </DockPanel>
                    <TextBlock Text="{app:T hk_hint}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <!-- Поведение -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Eyebrow}"><Run Text="{app:T ov_behavior, Upper=True}" /></TextBlock>
                    <CheckBox x:Name="HideUnfocused" Content="{app:T ov_hide_unfocused}" Checked="Behavior_Changed" Unchecked="Behavior_Changed" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="{app:T ov_process}" Style="{StaticResource FieldLabel}" Margin="0,0,10,0" />
                        <TextBox x:Name="ProcessName" Width="180" FontFamily="{StaticResource MonoFont}" LostFocus="Behavior_Changed" />
                    </StackPanel>
                    <TextBlock Text="{app:T ov_process_hint}" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <!-- Профили -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Eyebrow}"><Run Text="{app:T prof_title, Upper=True}" /><InlineUIContainer BaselineAlignment="Center"><v:HelpTip Text="{app:T help_profiles}" /></InlineUIContainer></TextBlock>
                    <TextBlock Text="{app:T prof_hint}" Style="{StaticResource MutedText}" Margin="0,0,0,10" />
                    <WrapPanel x:Name="ProfilePanel" />
                    <DockPanel Margin="0,6,0,0">
                        <Button DockPanel.Dock="Left" Content="{app:T prof_save}" Click="SaveProfile_Click" />
                        <TextBlock x:Name="ProfileStatus" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </DockPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
