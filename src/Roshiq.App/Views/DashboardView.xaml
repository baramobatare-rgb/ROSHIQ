<UserControl x:Class="Roshiq.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:Roshiq.App"
             xmlns:ov="clr-namespace:Roshiq.Overlay;assembly=Roshiq.Overlay">
    <UserControl.Resources>
        <Style x:Key="StatusPill" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Panel2}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="0,0,8,8" />
        </Style>
        <Style x:Key="PillLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Faint}" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="PillValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="TileValue" TargetType="TextBlock" BasedOn="{StaticResource BigValue}">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Margin" Value="0,2,0,4" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,6,20">

            <!-- Уведомления: новый патч / новая версия ROSHIQ -->
            <Border x:Name="NoticeCard" Style="{StaticResource Card}" BorderBrush="{DynamicResource Warning}" Visibility="Collapsed" Padding="22,14">
                <DockPanel>
                    <ov:Icon DockPanel.Dock="Left" Glyph="{StaticResource I.Alert}" Size="18" Brush="{DynamicResource Warning}" Margin="0,1,12,0" VerticalAlignment="Top" />
                    <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Button Content="{app:T dash_notice_open}" Click="NoticeOpen_Click" />
                        <Button x:Name="NoticeDismiss" Style="{StaticResource GhostButton}" Content="{app:T dash_notice_dismiss}" Click="NoticeDismiss_Click" />
                    </WrapPanel>
                    <TextBlock x:Name="NoticeText" Style="{StaticResource Value}" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!-- ===== Главный блок: крупный заголовок слева, лента подсказок матча на наклонной полосе справа ===== -->
            <Grid Margin="0,4,0,30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="320" />
                    <ColumnDefinition Width="430" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,32,0">
                    <TextBlock x:Name="HeroEyebrow" Style="{StaticResource Eyebrow}" />
                    <TextBlock x:Name="Headline" Style="{StaticResource Display}" FontSize="46" LineHeight="46" LineStackingStrategy="BlockLineHeight" />
                    <TextBlock x:Name="HeadlineSub" Style="{StaticResource MutedText}" FontSize="15" Margin="0,12,0,16" MaxWidth="620" HorizontalAlignment="Left" />
                    <!-- Что важно прямо сейчас: таймеры и золото в матче, сводка в драфте, итог прошлой игры -->
                    <StackPanel x:Name="FocusPanel" Margin="0,0,0,16" MaxWidth="620" HorizontalAlignment="Left" />
                    <WrapPanel>
                        <Button Style="{StaticResource PrimaryButton}" Click="GoDraft_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{app:T dash_go_draft}" VerticalAlignment="Center" />
                                <ov:Icon Glyph="{StaticResource I.ArrowRight}" Size="15" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Click="GoBuild_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{app:T dash_go_build}" VerticalAlignment="Center" />
                                <ov:Icon Glyph="{StaticResource I.ArrowRight}" Size="15" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Click="ToggleOverlay_Click">
                            <StackPanel Orientation="Horizontal">
                                <ov:Icon Glyph="{StaticResource I.Eye}" Size="15" Margin="0,0,8,0" />
                                <TextBlock Text="{app:T dash_toggle_overlay}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="TestModeButton" Style="{StaticResource GhostButton}" Click="TestMode_Click" />
                        <Button x:Name="FixButton" Style="{StaticResource GhostButton}" Click="Fix_Click" Visibility="Collapsed" Foreground="{DynamicResource Warning}">
                            <StackPanel Orientation="Horizontal">
                                <ov:Icon Glyph="{StaticResource I.Alert}" Size="15" Brush="{DynamicResource Warning}" Margin="0,0,8,0" />
                                <TextBlock Text="{app:T dash_fix}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>

                    <!-- Состояние одной строкой; подробности — в подсказке при наведении -->
                    <WrapPanel Margin="0,12,0,0">
                        <Border Style="{StaticResource StatusPill}" Visibility="Collapsed" ToolTip="{Binding Text, ElementName=GameStatus}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="DOTA 2" Style="{StaticResource PillLabel}" />
                                <TextBlock x:Name="GameValue" Style="{StaticResource PillValue}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatusPill}" ToolTip="{Binding Text, ElementName=GsiStatus}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="GSI" Style="{StaticResource PillLabel}" />
                                <TextBlock x:Name="GsiValue" Style="{StaticResource PillValue}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatusPill}" ToolTip="{Binding Text, ElementName=OverlayStatus}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{app:T dash_overlay, Upper=True}" Style="{StaticResource PillLabel}" />
                                <TextBlock x:Name="OverlayValue" Style="{StaticResource PillValue}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatusPill}" ToolTip="{Binding Text, ElementName=ContextHint}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{app:T dash_mode, Upper=True}" Style="{StaticResource PillLabel}" />
                                <TextBlock x:Name="ModeValue" Style="{StaticResource PillValue}" />
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                    <!-- тексты подсказок для строки состояния -->
                    <TextBlock x:Name="GameStatus" Visibility="Collapsed" />
                    <TextBlock x:Name="GsiStatus" Visibility="Collapsed" />
                    <TextBlock x:Name="OverlayStatus" Visibility="Collapsed" />
                    <TextBlock x:Name="ContextHint" Visibility="Collapsed" />
                </StackPanel>

                <!-- Наклонная полоса в цвете темы (как диагональ на сайте) и поверх неё — тёмная панель с лентой подсказок -->
                <Grid Grid.Column="1" VerticalAlignment="Top" MinHeight="250">
                    <Border Background="{DynamicResource Accent}" Margin="70,-6,-70,-6" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                        <Border.RenderTransform>
                            <SkewTransform AngleX="-14" />
                        </Border.RenderTransform>
                    </Border>
                    <!-- жёсткая тень панели -->
                    <Border Background="#000000" Opacity="0.35" Margin="10,28,36,6" IsHitTestVisible="False" />
                    <Border x:Name="TipFeedCard" Background="{DynamicResource Bg}" Margin="0,18,46,16" Padding="20,16,20,18">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock x:Name="TipFeedCounts" DockPanel.Dock="Right" Style="{StaticResource MutedText}" FontSize="12" VerticalAlignment="Bottom" Margin="10,0,0,3" />
                                <TextBlock Text="{app:T feed_title}" Style="{StaticResource CellTitle}" FontSize="19" Margin="0" />
                            </DockPanel>
                            <StackPanel x:Name="TipFeedPanel" />
                            <TextBlock x:Name="TipFeedEmpty" Style="{StaticResource MutedText}" TextWrapping="Wrap" Text="{app:T feed_empty}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- ===== Нижний ряд: плоские ячейки под толстой чертой — связь, герой, цель, профиль ===== -->
            <Border BorderBrush="{DynamicResource Text}" BorderThickness="0,2,0,0" Margin="0,0,0,26">
                <UniformGrid Rows="1">
                    <!-- Always-visible connection state with a concrete reason and one path to fix it. -->
                    <Border x:Name="ConnectionCard" Style="{StaticResource Cell}" Padding="0,18,20,22">
                        <StackPanel>
                            <TextBlock Text="{app:T conn_header}" Style="{StaticResource CellTitle}" />
                            <DockPanel>
                                <Border x:Name="ConnectionMark" DockPanel.Dock="Left" Width="9" Height="9" Margin="0,6,9,0" VerticalAlignment="Top" Background="{DynamicResource Faint}" />
                                <TextBlock x:Name="ConnectionTitle" Style="{StaticResource Value}" FontWeight="Bold" />
                            </DockPanel>
                            <TextBlock x:Name="ConnectionDetail" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            <Button x:Name="ConnectionAction" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="-10,6,0,0"
                                    Content="{app:T conn_diagnostics}" Click="Fix_Click" />
                        </StackPanel>
                    </Border>

                    <!-- Герой, роль и следующий предмет -->
                    <Border Style="{StaticResource Cell}">
                        <StackPanel>
                            <TextBlock Text="{app:T cell_hero}" Style="{StaticResource CellTitle}" />
                            <DockPanel Margin="0,0,0,10">
                                <ContentControl x:Name="HeroPortraitHost" DockPanel.Dock="Left" Focusable="False" Margin="0,0,12,0" VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="HeroName" Style="{StaticResource BigValue}" FontSize="20" FontWeight="ExtraBold" />
                                    <TextBlock x:Name="HeroMeta" Style="{StaticResource MutedText}" Margin="0,3,0,0" />
                                </StackPanel>
                            </DockPanel>
                            <ComboBox x:Name="QuickPosition" SelectionChanged="QuickPosition_Changed" Margin="0,0,0,10" />
                            <TextBlock Style="{StaticResource Eyebrow}" Text="{app:T dash_next_item, Upper=True}" Margin="0,0,0,6" />
                            <DockPanel>
                                <Border x:Name="NextItemIcon" DockPanel.Dock="Left" Width="44" Height="32" CornerRadius="3" Margin="0,0,10,0" Visibility="Collapsed" VerticalAlignment="Center" />
                                <TextBlock x:Name="NextItem" Style="{StaticResource Value}" FontWeight="Bold" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock x:Name="NextItemWhy" Style="{StaticResource MutedText}" Margin="0,6,0,0" TextWrapping="Wrap" />
                            <Button Content="{app:T quick_hero}" Click="ChooseHero_Click" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="-10,6,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Цель на игру -->
                    <Border x:Name="GoalCard" Style="{StaticResource Cell}" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="{app:T cell_goal}" Style="{StaticResource CellTitle}" />
                            <TextBlock x:Name="GoalLine" Style="{StaticResource BigValue}" FontSize="19" FontWeight="ExtraBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="GoalSub" Style="{StaticResource MutedText}" Margin="0,6,0,0" TextWrapping="Wrap" />
                            <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="-10,6,0,0" Content="{app:T goal_open}" Click="GoalOpen_Click" />
                        </StackPanel>
                    </Border>

                    <!-- Профиль Steam -->
                    <Border x:Name="ProfileCard" Style="{StaticResource Cell}" BorderThickness="0" Padding="20,18,0,22">
                        <StackPanel>
                            <TextBlock Text="{app:T cell_profile}" Style="{StaticResource CellTitle}" />
                            <DockPanel>
                                <Border x:Name="ProfileAvatar" DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="3" Margin="0,0,12,0"
                                        Background="{DynamicResource Panel3}" VerticalAlignment="Top">
                                    <ov:Icon x:Name="ProfileAvatarIcon" Glyph="{StaticResource I.Shield}" Size="16" Brush="{DynamicResource Faint}"
                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel>
                                    <TextBlock x:Name="ProfileName" Style="{StaticResource Value}" FontWeight="Bold" />
                                    <TextBlock x:Name="ProfileSub" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="ProfileWeak" Style="{StaticResource MutedText}" Foreground="{DynamicResource Warning}" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>
                            <Button x:Name="ProfileButton" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="-10,6,0,0" Click="ProfileOpen_Click" />
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </Border>

            <!-- Блок состояния (нет подключения / ошибка) -->
            <Border x:Name="StateCard" Style="{StaticResource Card}" Visibility="Collapsed">
                <ContentControl x:Name="StateHost" Focusable="False" />
            </Border>

            <!-- Последние матчи: результаты, винрейт и главная ошибка прошлой игры -->
            <Border x:Name="RecentCard" Style="{StaticResource Card}" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Style="{StaticResource Eyebrow}"><Run Text="{app:T dash_recent, Upper=True}" /></TextBlock>
                        <WrapPanel x:Name="RecentStrip" Margin="0,2,0,10" />
                        <TextBlock x:Name="RecentSummary" Style="{StaticResource Value}" />
                        <TextBlock x:Name="RecentSub" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Style="{StaticResource Eyebrow}"><Run Text="{app:T dash_last_lesson, Upper=True}" /></TextBlock>
                        <TextBlock x:Name="LessonText" Style="{StaticResource Value}" TextWrapping="Wrap" />
                        <TextBlock x:Name="LessonSub" Style="{StaticResource MutedText}" Margin="0,4,0,10" />
                        <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Click="GoHistory_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{app:T dash_go_history}" VerticalAlignment="Center" />
                                <ov:Icon Glyph="{StaticResource I.ArrowRight}" Size="15" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Неделя: результаты, серия, лучший и худший герой, главная повторяющаяся ошибка -->
            <Border x:Name="WeekCard" Style="{StaticResource Card}" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Style="{StaticResource Eyebrow}"><Run Text="{app:T week_title, Upper=True}" /></TextBlock>
                        <TextBlock x:Name="WeekLine" Style="{StaticResource Value}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock x:Name="WeekSub" Style="{StaticResource MutedOptional}" Margin="0,2,0,0" TextWrapping="Wrap" />
                        <WrapPanel x:Name="WeekChips" Margin="0,10,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Style="{StaticResource Eyebrow}"><Run Text="{app:T week_mistake, Upper=True}" /></TextBlock>
                        <TextBlock x:Name="WeekMistake" Style="{StaticResource Value}" TextWrapping="Wrap" />
                        <TextBlock x:Name="WeekMistakeSub" Style="{StaticResource MutedOptional}" Margin="0,4,0,10" TextWrapping="Wrap" />
                        <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Click="GoStats_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{app:T week_go_stats}" VerticalAlignment="Center" />
                                <ov:Icon Glyph="{StaticResource I.ArrowRight}" Size="15" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
