<UserControl x:Class="Roshiq.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:Roshiq.App"
             xmlns:v="clr-namespace:Roshiq.App.Views"
             xmlns:ov="clr-namespace:Roshiq.Overlay;assembly=Roshiq.Overlay">
    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <!-- Строка настройки: короткое название и серое пояснение под ним -->
        <Style x:Key="OptTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="OptDesc" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="LineHeight" Value="17" />
            <Setter Property="Margin" Value="0,1,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="GroupHead" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Faint}" />
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,14,0,2" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,6,20">

            <!-- Режим подсказок -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Eyebrow}"><Run Text="{app:T preset_title, Upper=True}" /><InlineUIContainer BaselineAlignment="Center"><v:HelpTip Text="{app:T help_preset}" /></InlineUIContainer></TextBlock>
                    <WrapPanel>
                        <RadioButton x:Name="PresetMin" Style="{StaticResource Segment}" GroupName="Preset" Content="{app:T preset_minimal}" Checked="Preset_Checked" Margin="0,0,8,8" />
                        <RadioButton x:Name="PresetNormal" Style="{StaticResource Segment}" GroupName="Preset" Content="{app:T preset_normal}" Checked="Preset_Checked" Margin="0,0,8,8" />
                        <RadioButton x:Name="PresetFull" Style="{StaticResource Segment}" GroupName="Preset" Content="{app:T preset_full}" Checked="Preset_Checked" Margin="0,0,8,8" />
                    </WrapPanel>
                    <TextBlock x:Name="PresetDescription" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                    <DockPanel Margin="0,10,0,0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{app:T set_run_wizard}" Click="RunWizard_Click" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{app:T set_diagnostics}" Click="Diagnostics_Click" />
                        <CheckBox x:Name="AdvancedBox" Content="{app:T set_show_advanced}" Checked="Advanced_Changed" Unchecked="Advanced_Changed" VerticalAlignment="Center" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Optional advice can be saved for the match recap instead of interrupting play. -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{app:T advice_delivery_title, Upper=True}" Style="{StaticResource Eyebrow}" />
                    <TextBlock Text="{app:T advice_delivery_desc}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,10" />
                    <CheckBox x:Name="StrategyDuringMatchBox" Checked="AdviceDelivery_Changed" Unchecked="AdviceDelivery_Changed" Margin="0,0,0,5">
                        <StackPanel><TextBlock Text="{app:T advice_strategy}" Style="{StaticResource OptTitle}" /><TextBlock Text="{app:T advice_strategy_desc}" Style="{StaticResource OptDesc}" /></StackPanel>
                    </CheckBox>
                    <CheckBox x:Name="PaceDuringMatchBox" Checked="AdviceDelivery_Changed" Unchecked="AdviceDelivery_Changed" Margin="0,0,0,5">
                        <StackPanel><TextBlock Text="{app:T advice_pace}" Style="{StaticResource OptTitle}" /><TextBlock Text="{app:T advice_pace_desc}" Style="{StaticResource OptDesc}" /></StackPanel>
                    </CheckBox>
                    <CheckBox x:Name="ItemsDuringMatchBox" Checked="AdviceDelivery_Changed" Unchecked="AdviceDelivery_Changed">
                        <StackPanel><TextBlock Text="{app:T advice_items}" Style="{StaticResource OptTitle}" /><TextBlock Text="{app:T advice_items_desc}" Style="{StaticResource OptDesc}" /></StackPanel>
                    </CheckBox>
                </StackPanel>
            </Border>

            <!-- Оформление -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Margin="0,0,8,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Eyebrow}"><Run Text="{app:T set_appearance, Upper=True}" /></TextBlock>
                        <TextBlock Text="{app:T set_theme}" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                        <WrapPanel x:Name="ThemePanel" Margin="0,0,0,12" />
                        <TextBlock Text="{app:T set_backdrop}" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                        <WrapPanel x:Name="BackdropPanel" Margin="0,0,0,12" />
                        <CheckBox x:Name="ReduceMotionBox" Content="{app:T set_reduce_motion}" ToolTip="{app:T set_reduce_motion_hint}" Checked="Motion_Changed" Unchecked="Motion_Changed" Margin="0,0,0,8" />
                        <CheckBox x:Name="CursorGlowBox" Content="{app:T set_cursor_glow}" ToolTip="{app:T set_cursor_glow_hint}" Checked="Glow_Changed" Unchecked="Glow_Changed" Margin="0,0,0,12" />
                        <TextBlock Text="{app:T set_ui_scale}" Style="{StaticResource FieldLabel}" />
                        <DockPanel>
                            <TextBlock x:Name="UiScaleText" DockPanel.Dock="Right" Width="52" TextAlignment="Right" FontFamily="{StaticResource MonoFont}"
                                       Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                            <Slider x:Name="UiScaleSlider" Minimum="0.85" Maximum="1.6" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                    ValueChanged="UiScale_Changed" />
                        </DockPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Eyebrow}"><Run Text="{app:T set_general, Upper=True}" /></TextBlock>
                        <TextBlock Text="{app:T set_language}" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="LanguageBox" Width="200" HorizontalAlignment="Left" SelectionChanged="Language_Changed" />
                        <CheckBox x:Name="AutostartBox" Content="{app:T set_autostart}" Margin="0,12,0,0" Checked="Autostart_Changed" Unchecked="Autostart_Changed" />
                        <CheckBox x:Name="TrayMinimizeBox" Content="{app:T set_tray_minimize}" Margin="0,8,0,0" Checked="Tray_Changed" Unchecked="Tray_Changed" />
                        <CheckBox x:Name="TrayCloseBox" Content="{app:T set_tray_close}" Margin="0,8,0,0" Checked="Tray_Changed" Unchecked="Tray_Changed" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Режим допуска -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Eyebrow}"><Run Text="{app:T set_context, Upper=True}" /><InlineUIContainer BaselineAlignment="Center"><v:HelpTip Text="{app:T help_context}" /></InlineUIContainer></TextBlock>
                    <UniformGrid Columns="2">
                        <Border Style="{StaticResource InnerCard}" Margin="0,0,8,0">
                            <StackPanel>
                                <RadioButton x:Name="CtxReference" GroupName="Ctx" FontWeight="SemiBold" Content="{app:T ctx_reference}" Checked="Context_Checked" />
                                <TextBlock Text="{app:T ctx_reference_hint}" Style="{StaticResource MutedText}" Margin="30,0,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource InnerCard}" Margin="8,0,0,0">
                            <StackPanel>
                                <RadioButton x:Name="CtxTraining" GroupName="Ctx" FontWeight="SemiBold" Content="{app:T ctx_training}" Checked="Context_Checked" />
                                <TextBlock Text="{app:T ctx_training_hint}" Style="{StaticResource MutedText}" Margin="30,0,0,0" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    <DockPanel Margin="0,14,0,0">
                        <ov:Icon DockPanel.Dock="Left" Glyph="{StaticResource I.Shield}" Size="16" Brush="{DynamicResource Warning}" Margin="0,1,10,0" VerticalAlignment="Top" />
                        <TextBlock Text="{app:T ctx_rules_note}" Style="{StaticResource MutedText}" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Game State Integration -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Eyebrow}"><Run Text="GAME STATE INTEGRATION" /><InlineUIContainer BaselineAlignment="Center"><v:HelpTip Text="{app:T help_gsi}" /></InlineUIContainer></TextBlock>
                    <CheckBox x:Name="GsiEnabled" Content="{app:T set_gsi_enabled}" />
                    <Grid x:Name="GsiAdvanced" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                        <TextBlock Text="{app:T set_gsi_port}" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="GsiPort" Grid.Column="1" Width="110" HorizontalAlignment="Left" FontFamily="{StaticResource MonoFont}" />
                        <TextBlock Grid.Row="1" Text="{app:T set_dota_path}" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="DotaPath" Grid.Row="1" Grid.Column="1" />
                        <Button Grid.Row="1" Grid.Column="2" Content="{app:T set_detect}" Click="Detect_Click" Margin="8,3,0,3" />
                    </Grid>
                    <WrapPanel Margin="0,10,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Click="WriteCfg_Click">
                            <StackPanel Orientation="Horizontal">
                                <ov:Icon Glyph="{StaticResource I.Link}" Size="15" Margin="0,0,8,0" />
                                <TextBlock Text="{app:T set_write_cfg}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Content="{app:T save}" Click="SaveGsi_Click" />
                        <Button Style="{StaticResource GhostButton}" Content="{app:T set_copy_cfg}" Click="CopyCfg_Click" />
                        <Button Style="{StaticResource GhostButton}" Content="{app:T set_new_token}" Click="NewToken_Click" />
                    </WrapPanel>
                    <TextBlock x:Name="GsiStatus" Style="{StaticResource Value}" Margin="0,8,0,0" />
                    <TextBlock Text="{app:T set_gsi_hint}" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <!-- Распознавание драфта -->
            <Border x:Name="VisionCard" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Eyebrow}"><Run Text="{app:T set_vision, Upper=True}" /><InlineUIContainer BaselineAlignment="Center"><v:HelpTip Text="{app:T help_vision}" /></InlineUIContainer></TextBlock>
                    <CheckBox x:Name="VisionEnabled" Content="{app:T set_vision_enabled}" />
                    <TextBlock Text="{app:T set_vision_hint}" Style="{StaticResource MutedText}" Margin="0,2,0,12" />
                    <UniformGrid Columns="4">
                        <StackPanel Margin="0,0,10,8"><TextBlock Text="{app:T set_vision_interval}" Style="{StaticResource FieldLabel}" /><TextBox x:Name="VisionInterval" FontFamily="{StaticResource MonoFont}" /></StackPanel>
                        <StackPanel Margin="0,0,10,8"><TextBlock Text="{app:T set_vision_threshold}" Style="{StaticResource FieldLabel}" /><TextBox x:Name="VisionThreshold" FontFamily="{StaticResource MonoFont}" /></StackPanel>
                        <StackPanel Margin="0,0,10,8"><TextBlock Text="Radiant X" Style="{StaticResource FieldLabel}" /><TextBox x:Name="LRadiant" FontFamily="{StaticResource MonoFont}" /></StackPanel>
                        <StackPanel Margin="0,0,0,8"><TextBlock Text="Dire X" Style="{StaticResource FieldLabel}" /><TextBox x:Name="LDire" FontFamily="{StaticResource MonoFont}" /></StackPanel>
                        <StackPanel Margin="0,0,10,8"><TextBlock Text="{app:T set_slot_size}" Style="{StaticResource FieldLabel}" /><TextBox x:Name="LSlotW" FontFamily="{StaticResource MonoFont}" /></StackPanel>
                        <StackPanel Margin="0,0,10,8"><TextBlock Text="{app:T set_slot_height}" Style="{StaticResource FieldLabel}" /><TextBox x:Name="LSlotH" FontFamily="{StaticResource MonoFont}" /></StackPanel>
                        <StackPanel Margin="0,0,10,8"><TextBlock Text="{app:T set_slot_step}" Style="{StaticResource FieldLabel}" /><TextBox x:Name="LStep" FontFamily="{StaticResource MonoFont}" /></StackPanel>
                        <StackPanel Margin="0,0,0,8"><TextBlock Text="{app:T set_slot_top}" Style="{StaticResource FieldLabel}" /><TextBox x:Name="LTop" FontFamily="{StaticResource MonoFont}" /></StackPanel>
                    </UniformGrid>
                    <WrapPanel Margin="0,6,0,0">
                        <Button Content="{app:T save}" Click="SaveVision_Click" />
                        <Button Style="{StaticResource GhostButton}" Content="{app:T set_open_templates}" Click="OpenTemplates_Click" />
                    </WrapPanel>
                    <TextBlock x:Name="VisionStatus" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- Работа с игрой -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Style="{StaticResource Eyebrow}"><Run Text="{app:T set_automation, Upper=True}" /><InlineUIContainer BaselineAlignment="Center"><v:HelpTip Text="{app:T help_automation}" /></InlineUIContainer></TextBlock>
                    <!-- Порядок — как идёт игра: запуск → драфт → матч → после матча. Названия короткие, пояснение — серой строкой. -->
                    <TextBlock Text="{app:T set_grp_launch}" Style="{StaticResource GroupHead}" Margin="0,2,0,2" />
                    <CheckBox x:Name="AutoWatchBox" Checked="Automation_Changed" Unchecked="Automation_Changed" Margin="0,0,0,4">
                        <StackPanel><TextBlock Text="{app:T set_auto_watch}" Style="{StaticResource OptTitle}" /><TextBlock Text="{app:T set_auto_watch_d}" Style="{StaticResource OptDesc}" /></StackPanel>
                    </CheckBox>
                    <CheckBox x:Name="AutoHideBox" Checked="Automation_Changed" Unchecked="Automation_Changed" Margin="28,0,0,4">
                        <StackPanel><TextBlock Text="{app:T set_auto_hide}" Style="{StaticResource OptTitle}" /><TextBlock Text="{app:T set_auto_hide_d}" Style="{StaticResource OptDesc}" /></StackPanel>
                    </CheckBox>
                    <CheckBox x:Name="AutoShowBox" Checked="Automation_Changed" Unchecked="Automation_Changed" Margin="28,0,0,4">
                        <StackPanel><TextBlock Text="{app:T set_auto_show}" Style="{StaticResource OptTitle}" /><TextBlock Text="{app:T set_auto_show_d}" Style="{StaticResource OptDesc}" /></StackPanel>
                    </CheckBox>
                    <TextBlock Text="{app:T set_grp_draft}" Style="{StaticResource GroupHead}" />
                    <CheckBox x:Name="DraftToastsBox" Checked="Automation_Changed" Unchecked="Automation_Changed" Margin="0,0,0,4">
                        <StackPanel><TextBlock Text="{app:T set_draft_toasts}" Style="{StaticResource OptTitle}" /><TextBlock Text="{app:T set_draft_toasts_d}" Style="{StaticResource OptDesc}" /></StackPanel>
                    </CheckBox>
                    <TextBlock Text="{app:T set_grp_game}" Style="{StaticResource GroupHead}" />
                    <CheckBox x:Name="AutoRoleBox" Checked="Automation_Changed" Unchecked="Automation_Changed" Margin="0,0,0,4">
                        <StackPanel><TextBlock Text="{app:T set_auto_role}" Style="{StaticResource OptTitle}" /><TextBlock Text="{app:T set_auto_role_d}" Style="{StaticResource OptDesc}" /></StackPanel>
                    </CheckBox>
                    <CheckBox x:Name="AutoModesBox" Checked="Automation_Changed" Unchecked="Automation_Changed" Margin="0,0,0,4">
                        <StackPanel><TextBlock Text="{app:T set_auto_modes}" Style="{StaticResource OptTitle}" /><TextBlock Text="{app:T set_auto_modes_d}" Style="{StaticResource OptDesc}" /></StackPanel>
                    </CheckBox>
                    <CheckBox x:Name="LaneTipsBox" Checked="Automation_Changed" Unchecked="Automation_Changed" Margin="0,0,0,4">
                        <StackPanel><TextBlock Text="{app:T set_lane_tips}" Style="{StaticResource OptTitle}" /><TextBlock Text="{app:T set_lane_tips_d}" Style="{StaticResource OptDesc}" /></StackPanel>
                    </CheckBox>
                    <CheckBox x:Name="PowerSpikesBox" Checked="Automation_Changed" Unchecked="Automation_Changed" Margin="0,0,0,4">
                        <StackPanel><TextBlock Text="{app:T set_power_spikes}" Style="{StaticResource OptTitle}" /><TextBlock Text="{app:T set_power_spikes_d}" Style="{StaticResource OptDesc}" /></StackPanel>
                    </CheckBox>
                    <CheckBox x:Name="ShowBuildBox" Checked="Automation_Changed" Unchecked="Automation_Changed" Margin="0,0,0,4">
                        <StackPanel><TextBlock Text="{app:T set_show_build}" Style="{StaticResource OptTitle}" /><TextBlock Text="{app:T set_show_build_d}" Style="{StaticResource OptDesc}" /></StackPanel>
                    </CheckBox>
                    <TextBlock Text="{app:T set_grp_after}" Style="{StaticResource GroupHead}" />
                    <CheckBox x:Name="PostMatchBox" Checked="Automation_Changed" Unchecked="Automation_Changed" Margin="0,0,0,4">
                        <StackPanel><TextBlock Text="{app:T set_post_match}" Style="{StaticResource OptTitle}" /><TextBlock Text="{app:T set_post_match_d}" Style="{StaticResource OptDesc}" /></StackPanel>
                    </CheckBox>
                    <CheckBox x:Name="AutoImportBox" Checked="Automation_Changed" Unchecked="Automation_Changed" Margin="0,0,0,4">
                        <StackPanel><TextBlock Text="{app:T set_auto_import}" Style="{StaticResource OptTitle}" /><TextBlock Text="{app:T set_auto_import_d}" Style="{StaticResource OptDesc}" /></StackPanel>
                    </CheckBox>
                    <CheckBox x:Name="AutoReviewBox" Checked="Automation_Changed" Unchecked="Automation_Changed" Margin="0,0,0,4">
                        <StackPanel><TextBlock Text="{app:T set_auto_review}" Style="{StaticResource OptTitle}" /><TextBlock Text="{app:T set_auto_review_d}" Style="{StaticResource OptDesc}" /></StackPanel>
                    </CheckBox>
                    <DockPanel Margin="52,2,0,14">
                        <Button x:Name="OpenDotaLinkButton" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{app:T set_opendota_link}"
                                Click="OpenDotaLink_Click" VerticalAlignment="Top" Margin="12,0,0,0" />
                        <TextBlock x:Name="OpenDotaNote" Text="{app:T set_opendota_need}" Style="{StaticResource OptDesc}" />
                    </DockPanel>
                    <DockPanel>
                        <ov:Icon DockPanel.Dock="Left" Glyph="{StaticResource I.Shield}" Size="16" Brush="{DynamicResource Accent}" Margin="0,1,10,0" VerticalAlignment="Top" />
                        <TextBlock Text="{app:T set_auto_note}" Style="{StaticResource MutedText}" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Звуки уведомлений -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Style="{StaticResource Eyebrow}"><Run Text="{app:T snd_title, Upper=True}" /><InlineUIContainer BaselineAlignment="Center"><v:HelpTip Text="{app:T help_sounds}" /></InlineUIContainer></TextBlock>
                    <CheckBox x:Name="SoundsBox" Content="{app:T snd_enabled}" Checked="Sounds_Changed" Unchecked="Sounds_Changed" Margin="0,0,0,10" />
                    <Grid x:Name="SoundsGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{app:T snd_volume}" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                        <DockPanel Grid.Column="1" Margin="0,4">
                            <TextBlock x:Name="VolumeText" DockPanel.Dock="Right" Style="{StaticResource MutedText}" Width="44" TextAlignment="Right" VerticalAlignment="Center" />
                            <Slider x:Name="VolumeSlider" Minimum="0" Maximum="1" ValueChanged="Volume_Changed" />
                        </DockPanel>
                        <TextBlock Grid.Row="1" Text="{app:T snd_reminder}" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                        <WrapPanel x:Name="ReminderSounds" Grid.Row="1" Grid.Column="1" Margin="0,4" Tag="Reminder" />
                        <TextBlock Grid.Row="2" Text="{app:T snd_warning}" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                        <WrapPanel x:Name="WarningSounds" Grid.Row="2" Grid.Column="1" Margin="0,4" Tag="Warning" />
                        <TextBlock Grid.Row="3" Text="{app:T snd_event}" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                        <WrapPanel x:Name="EventSounds" Grid.Row="3" Grid.Column="1" Margin="0,4" Tag="Event" />
                    </Grid>
                    <TextBlock Text="{app:T snd_hint}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <!-- Steam -->
            <Border x:Name="SteamCard" Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Style="{StaticResource Eyebrow}"><Run Text="STEAM" /><InlineUIContainer BaselineAlignment="Center"><v:HelpTip Text="{app:T help_steam}" /></InlineUIContainer></TextBlock>
                    <DockPanel Margin="0,2,0,12">
                        <Border x:Name="SteamAvatar" DockPanel.Dock="Left" Width="52" Height="52" CornerRadius="10" Margin="0,0,14,0"
                                Background="{DynamicResource Panel3}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1">
                            <ov:Icon x:Name="SteamAvatarIcon" Glyph="{StaticResource I.Shield}" Size="20" Brush="{DynamicResource Faint}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="SteamNameText" Style="{StaticResource Value}" FontWeight="SemiBold" FontSize="16" />
                            <TextBlock x:Name="SteamDetails" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock x:Name="SteamWarning" Style="{StaticResource MutedText}" Foreground="{DynamicResource Warning}"
                               TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,10" />
                    <WrapPanel>
                        <Button x:Name="SteamSignInButton" Content="{app:T steam_signin}" Click="SteamSignIn_Click" />
                        <Button Style="{StaticResource GhostButton}" Content="{app:T steam_find_local}" Click="SteamFindLocal_Click" />
                        <Button x:Name="SteamRefreshButton" Style="{StaticResource GhostButton}" Content="{app:T steam_refresh}" Click="SteamRefresh_Click" />
                        <Button x:Name="SteamUnlinkButton" Style="{StaticResource GhostButton}" Content="{app:T steam_unlink}" Click="SteamUnlink_Click" />
                    </WrapPanel>
                    <StackPanel x:Name="SteamLocalList" Margin="0,6,0,0" />
                    <TextBlock x:Name="SteamStatus" Style="{StaticResource MutedText}" Margin="0,4,0,6" TextWrapping="Wrap" />
                    <CheckBox x:Name="PersonalStatsBox" Content="{app:T steam_use_stats}" Checked="PersonalStats_Changed" Unchecked="PersonalStats_Changed" Margin="0,4,0,8" />
                    <DockPanel>
                        <ov:Icon DockPanel.Dock="Left" Glyph="{StaticResource I.Shield}" Size="16" Brush="{DynamicResource Accent}" Margin="0,1,10,0" VerticalAlignment="Top" />
                        <TextBlock Text="{app:T steam_privacy}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Локальные данные -->
            <Border x:Name="StorageCard" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Eyebrow}"><Run Text="{app:T set_storage, Upper=True}" /></TextBlock>
                    <TextBlock x:Name="StoragePath" Style="{StaticResource Value}" FontFamily="{StaticResource MonoFont}" FontSize="12.5" />
                    <TextBlock Text="{app:T set_storage_hint}" Style="{StaticResource MutedText}" Margin="0,4,0,10" />
                    <WrapPanel>
                        <Button Content="{app:T set_open_folder}" Click="OpenFolder_Click" />
                        <Button Content="{app:T set_export}" Click="Export_Click" />
                        <Button Content="{app:T set_import}" Click="Import_Click" />
                    </WrapPanel>
                    <TextBlock x:Name="StorageStatus" Style="{StaticResource MutedText}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
