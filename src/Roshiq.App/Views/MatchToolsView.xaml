<UserControl x:Class="Roshiq.App.Views.MatchToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:Roshiq.App"
             xmlns:ov="clr-namespace:Roshiq.Overlay;assembly=Roshiq.Overlay">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Таймеры событий и Рошан -->
        <Border Style="{StaticResource Card}" Margin="0,0,8,16">
            <StackPanel>
                <TextBlock Style="{StaticResource Eyebrow}"><Run Text="01 / " Foreground="{DynamicResource Accent}" /><Run Text="{app:T timers_title, Upper=True}" /></TextBlock>
                <CheckBox x:Name="TimersEnabled" FontWeight="SemiBold" Content="{app:T timers_enabled}" Checked="Timers_Changed" Unchecked="Timers_Changed" />
                <CheckBox x:Name="TimerToasts" Content="{app:T timers_toasts}" Margin="0,6,0,0" Checked="Timers_Changed" Unchecked="Timers_Changed" />
                <TextBlock Text="{app:T timers_hint}" Style="{StaticResource MutedText}" Margin="0,6,0,10" />
                <WrapPanel x:Name="TimerKinds" Margin="0,0,0,6" />
                <Border Height="1" Background="{DynamicResource Line}" Margin="0,8,0,12" />
                <TextBlock Style="{StaticResource Eyebrow}" Text="{app:T timers_next, Upper=True}" />
                <StackPanel x:Name="UpcomingPanel" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Column="1" Margin="8,0,0,0">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Eyebrow}"><Run Text="02 / " Foreground="{DynamicResource Accent}" /><Run Text="{app:T rosh_title, Upper=True}" /></TextBlock>
                    <TextBlock x:Name="RoshanHint" Style="{StaticResource MutedText}" Margin="0,0,0,10" />
                    <TextBlock x:Name="RoshanStatusText" Style="{StaticResource BigValue}" FontSize="22" Margin="0,0,0,10" />
                    <WrapPanel>
                        <Button Style="{StaticResource PrimaryButton}" Click="RoshanKill_Click">
                            <StackPanel Orientation="Horizontal">
                                <ov:Icon Glyph="{StaticResource I.Clock}" Size="15" Margin="0,0,8,0" />
                                <TextBlock Text="{app:T rosh_mark}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Content="{app:T rosh_clear}" Click="RoshanClear_Click" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Eyebrow}"><Run Text="03 / " Foreground="{DynamicResource Accent}" /><Run Text="{app:T alerts_title, Upper=True}" /></TextBlock>
                    <CheckBox x:Name="AlertsEnabled" FontWeight="SemiBold" Content="{app:T alerts_enabled}" Checked="Alerts_Changed" Unchecked="Alerts_Changed" />
                    <TextBlock Text="{app:T alerts_hint}" Style="{StaticResource MutedText}" Margin="0,4,0,10" />
                    <CheckBox x:Name="AlertTp" Content="{app:T alert_opt_tp}" Checked="Alerts_Changed" Unchecked="Alerts_Changed" />
                    <CheckBox x:Name="AlertStash" Content="{app:T alert_opt_stash}" Margin="0,6,0,0" Checked="Alerts_Changed" Unchecked="Alerts_Changed" />
                    <DockPanel Margin="0,6,0,0">
                        <TextBox x:Name="GoldThreshold" DockPanel.Dock="Right" Width="80" FontFamily="{StaticResource MonoFont}" LostFocus="Alerts_Changed" />
                        <CheckBox x:Name="AlertGold" Content="{app:T alert_opt_gold}" Checked="Alerts_Changed" Unchecked="Alerts_Changed" VerticalAlignment="Center" />
                    </DockPanel>
                    <DockPanel Margin="0,6,0,0">
                        <TextBox x:Name="BuybackMinute" DockPanel.Dock="Right" Width="80" FontFamily="{StaticResource MonoFont}" LostFocus="Alerts_Changed" />
                        <CheckBox x:Name="AlertBuyback" Content="{app:T alert_opt_buyback}" Checked="Alerts_Changed" Unchecked="Alerts_Changed" VerticalAlignment="Center" />
                    </DockPanel>
                    <CheckBox x:Name="AlertPace" Content="{app:T alert_opt_pace}" ToolTip="{app:T alert_opt_pace_hint}" Margin="0,10,0,0" Checked="Alerts_Changed" Unchecked="Alerts_Changed" />
                    <CheckBox x:Name="AlertAdaptive" Content="{app:T alert_opt_adaptive}" ToolTip="{app:T alert_opt_adaptive_hint}" Margin="0,6,0,0" Checked="Alerts_Changed" Unchecked="Alerts_Changed" />
                    <TextBlock x:Name="AdaptiveInfo" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                    <TextBlock x:Name="AlertsStatus" Style="{StaticResource MutedText}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
