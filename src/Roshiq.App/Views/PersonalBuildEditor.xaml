<Window x:Class="Roshiq.App.Views.PersonalBuildEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:Roshiq.App"
        Title="ROSHIQ" Icon="{DynamicResource AppIcon}" Width="1060" Height="780" MinWidth="850" MinHeight="640"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock x:Name="ContextLabel" Style="{StaticResource Eyebrow}" />
            <TextBlock Text="{app:T my_editor}" Style="{StaticResource H1}" />
            <TextBlock Text="{app:T my_editor_hint}" Style="{StaticResource MutedText}" Margin="0,0,0,14" />
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
            <Grid Margin="0,0,18,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="{app:T my_name}" Style="{StaticResource Eyebrow}" Margin="0,0,0,4" />
                    <TextBox x:Name="NameBox" MaxLength="100" AutomationProperties.Name="{app:T my_name}" />
                    <TextBlock Text="{app:T my_search_items}" Style="{StaticResource MutedText}" Margin="0,10,0,2" />
                    <TextBox x:Name="ItemSearch" TextChanged="Search_Changed" AutomationProperties.Name="{app:T my_search_items}" />
                    <ComboBox x:Name="ItemBox" AutomationProperties.Name="{app:T my_add}" />
                    <TextBlock x:Name="SearchStatus" Style="{StaticResource MutedText}" Visibility="Collapsed" />
                </StackPanel>
                <Grid Grid.Row="1" Margin="0,6,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <ComboBox x:Name="AddPhase" AutomationProperties.Name="{app:T my_phase}" />
                    <Button Grid.Column="1" x:Name="AddButton" Content="{app:T my_add}" Click="Add_Click" Margin="8,3,0,3" />
                </Grid>
                <TextBlock Grid.Row="2" Text="{app:T my_entries}" Style="{StaticResource Eyebrow}" />
                <Grid Grid.Row="3">
                    <ListBox x:Name="EntryList" SelectionChanged="Entry_Changed" AllowDrop="True" PreviewMouseLeftButtonDown="Entry_MouseDown"
                             PreviewMouseMove="Entry_MouseMove" Drop="Entry_Drop" HorizontalContentAlignment="Stretch">
                    </ListBox>
                    <TextBlock x:Name="EmptyLabel" Text="{app:T my_no_entries}" Style="{StaticResource MutedText}" Margin="20" IsHitTestVisible="False" />
                </Grid>
                <WrapPanel Grid.Row="4" Margin="0,8,0,0">
                    <Button x:Name="UpButton" Content="{app:T my_move_up}" Click="Up_Click" />
                    <Button x:Name="DownButton" Content="{app:T my_move_down}" Click="Down_Click" />
                    <Button x:Name="RemoveButton" Content="{app:T my_remove_item}" Click="Remove_Click" />
                </WrapPanel>
            </Grid>
            <Border Grid.Column="1" Style="{StaticResource InnerCard}" Padding="18">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{app:T my_notes}" Style="{StaticResource Eyebrow}" />
                        <TextBox x:Name="NotesBox" AcceptsReturn="True" TextWrapping="Wrap" Height="96" VerticalScrollBarVisibility="Auto" MaxLength="4000" AutomationProperties.Name="{app:T my_notes}" />
                        <Border Background="{DynamicResource Line}" Height="1" Margin="0,18" />
                        <TextBlock x:Name="SelectedItemTitle" Style="{StaticResource H2}" />
                        <StackPanel x:Name="EntryFields" IsEnabled="False">
                            <TextBlock Text="{app:T my_phase}" Style="{StaticResource Eyebrow}" Margin="0,0,0,4" />
                            <ComboBox x:Name="EntryPhase" SelectionChanged="Phase_Changed" AutomationProperties.Name="{app:T my_phase}" />
                            <TextBlock Text="{app:T my_entry_note}" Style="{StaticResource Eyebrow}" Margin="0,14,0,4" />
                            <TextBox x:Name="EntryNote" TextChanged="Note_Changed" AcceptsReturn="True" TextWrapping="Wrap" Height="90" VerticalScrollBarVisibility="Auto" MaxLength="2000" AutomationProperties.Name="{app:T my_entry_note}" />
                            <TextBlock Text="{app:T my_alternative}" Style="{StaticResource Eyebrow}" Margin="0,14,0,4" />
                            <ComboBox x:Name="AlternativeBox" SelectionChanged="Alternative_Changed" IsTextSearchEnabled="True" AutomationProperties.Name="{app:T my_alternative}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <DockPanel Grid.Row="2" Margin="0,16,0,0" LastChildFill="True">
            <WrapPanel DockPanel.Dock="Right">
                <Button Content="{app:T my_cancel}" Click="Cancel_Click" />
                <Button Content="{app:T my_save}" Style="{StaticResource PrimaryButton}" Click="Save_Click" Margin="0,4,0,4" />
            </WrapPanel>
            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Warning}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
        </DockPanel>
    </Grid>
</Window>
