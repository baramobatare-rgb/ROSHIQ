<UserControl x:Class="Roshiq.App.Views.SettingsHostView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:Roshiq.App">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,18">
            <RadioButton x:Name="TabGeneral" Style="{StaticResource Segment}" GroupName="SettingsTabs" Checked="Tab_Checked" Tag="general">
                <TextBlock><Run Text="01  " /><Run Text="{app:T set_tab_general, Upper=True}" /></TextBlock>
            </RadioButton>
            <RadioButton x:Name="TabOverlay" Style="{StaticResource Segment}" GroupName="SettingsTabs" Checked="Tab_Checked" Tag="overlay">
                <TextBlock><Run Text="02  " /><Run Text="{app:T set_tab_overlay, Upper=True}" /></TextBlock>
            </RadioButton>
            <RadioButton x:Name="TabData" Style="{StaticResource Segment}" GroupName="SettingsTabs" Checked="Tab_Checked" Tag="data">
                <TextBlock><Run Text="03  " /><Run Text="{app:T set_tab_data, Upper=True}" /></TextBlock>
            </RadioButton>
        </StackPanel>
        <ContentControl x:Name="TabHost" Focusable="False" />
    </DockPanel>
</UserControl>
