<UserControl x:Class="Roshiq.App.Views.DraftTrainerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:Roshiq.App"
             xmlns:ov="clr-namespace:Roshiq.Overlay;assembly=Roshiq.Overlay">
    <Border Style="{StaticResource Card}">
        <StackPanel>
            <DockPanel>
                <TextBlock x:Name="ScoreText" DockPanel.Dock="Right" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                <TextBlock Style="{StaticResource Eyebrow}"><Run Text="07 / " Foreground="{DynamicResource Accent}" /><Run Text="{app:T trainer_title, Upper=True}" /></TextBlock>
            </DockPanel>
            <TextBlock Text="{app:T trainer_hint}" Style="{StaticResource MutedText}" Margin="0,0,0,12" />
            <WrapPanel>
                <Button Style="{StaticResource PrimaryButton}" Click="New_Click">
                    <StackPanel Orientation="Horizontal">
                        <ov:Icon Glyph="{StaticResource I.Refresh}" Size="15" Margin="0,0,8,0" />
                        <TextBlock Text="{app:T trainer_new}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </WrapPanel>
            <StackPanel x:Name="ScenarioPanel" Visibility="Collapsed" Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Style="{StaticResource Eyebrow}" Text="{app:T trainer_enemies, Upper=True}" />
                        <WrapPanel x:Name="EnemyChips" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Style="{StaticResource Eyebrow}" Text="{app:T trainer_allies, Upper=True}" />
                        <WrapPanel x:Name="AllyChips" />
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="RoleText" Style="{StaticResource Value}" Margin="0,8,0,8" />
                <DockPanel>
                    <Button x:Name="AnswerButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Click="Answer_Click" Margin="10,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{app:T trainer_answer}" VerticalAlignment="Center" />
                            <ov:Icon Glyph="{StaticResource I.ArrowRight}" Size="15" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                    <ComboBox x:Name="PickBox" IsEditable="True" IsTextSearchEnabled="True" />
                </DockPanel>
                <StackPanel x:Name="ResultPanel" Margin="0,12,0,0" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
