<Window x:Class="Roshiq.App.Views.SafeModeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:Roshiq.App"
        Title="ROSHIQ" Icon="{DynamicResource AppIcon}" Width="600" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">
    <StackPanel Margin="28,24,28,22">
        <TextBlock Text="{app:T safe_eyebrow, Upper=True}" Style="{StaticResource Eyebrow}" Foreground="{DynamicResource Warning}" />
        <TextBlock Text="{app:T safe_title}" Style="{StaticResource H1}" Margin="0,0,0,10" />
        <TextBlock x:Name="Reason" TextWrapping="Wrap" Style="{StaticResource Value}" />
        <TextBlock Text="{app:T safe_what}" TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,10,0,0" />
        <TextBlock x:Name="Status" TextWrapping="Wrap" Style="{StaticResource Value}" Foreground="{DynamicResource Accent}" Margin="0,10,0,0" />
        <WrapPanel Margin="0,18,0,0">
            <Button Style="{StaticResource PrimaryButton}" Content="{app:T safe_restart}" Click="Restart_Click" />
            <Button Style="{StaticResource GhostButton}" Content="{app:T safe_reset}" Click="Reset_Click" />
            <Button Style="{StaticResource GhostButton}" Content="{app:T safe_diag}" Click="Diag_Click" />
            <Button x:Name="ReportButton" Style="{StaticResource GhostButton}" Content="{app:T safe_report}" Click="Report_Click" />
            <Button Style="{StaticResource GhostButton}" Content="{app:T safe_continue}" Click="Continue_Click" IsCancel="True" />
        </WrapPanel>
    </StackPanel>
</Window>
