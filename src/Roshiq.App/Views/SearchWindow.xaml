<Window x:Class="Roshiq.App.Views.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:Roshiq.App"
        Title="ROSHIQ" Width="620" SizeToContent="Height" MaxHeight="560" ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" WindowStartupLocation="CenterOwner" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">
    <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1" CornerRadius="14" Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.45" />
        </Border.Effect>
        <StackPanel Margin="14">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="ESC" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="8,0,4,0" />
                <TextBox x:Name="Query" FontSize="16" Padding="10,8" TextChanged="Query_TextChanged" PreviewKeyDown="Query_PreviewKeyDown" />
            </DockPanel>
            <ListBox x:Name="Results" Margin="0,10,0,0" MaxHeight="430" BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseUp="Results_MouseUp" />
            <TextBlock x:Name="Hint" Text="{app:T srch_hint}" Style="{StaticResource MutedText}" Margin="4,8,0,0" />
        </StackPanel>
    </Border>
</Window>
